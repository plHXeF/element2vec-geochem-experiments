const slide=(section,subtitle,topic,points,visual,notes)=>({section,subtitle,topic,points,visual,notes});
export const slides=[
 slide('', '多维图谱逐步走向过程检验','地球化学表征评价体系的逐步完善', ['传统编码与 latent space 的共同评价','2026.09.17'], {kind:'cover',path:R+'PartialMelting_median_frame016.png'},'来源：presentation_html；latent_evaluation_benchmark。封面图为已保存的部分熔融轨迹可视化，仅作示意。'),
 slide('1.评价体系沿革','上次汇报提出六维能力图谱','V1 的评价起点',['预测、邻域、结构已经量化','信息保真、指标连续性、泛化稳定性有待完善'],{kind:'diagram',nodes:['预测有效性','局部邻域','全局结构','信息保真','指标连续性','泛化稳定性'],grid:3},'来源：presentation_html/assets/figures/six_dimension_framework.svg；presentation_html/build_presentation.py。前三项原汇报已量化，后三项待完善。'),
 slide('1.评价体系沿革','早期量化集中在分类、邻域和聚类','黄铁矿多视图评价',['7,778 个样品；14 个元素；6 种矿床类型','rank/log 为强基线；地质 balance 增强部分聚类结构'],{kind:'image',path:P+'stage2_ability_profile.png'},'来源：presentation_html/index.html；stage2_ability_profile_table.csv。黄铁矿与后续全岩样本不能连成同一条性能曲线。'),
 slide('1.评价体系沿革','分类分数无法替代空间和过程检验','从预测结果提出新问题',['类别可以读出，距离仍可能不合理','局部轨迹平滑，复合过程仍可能预测失败'],{kind:'diagram',nodes:['类别可读','距离有意义','过程可预测'],captions:['探针','原生空间','多阶段推进']},'概念示意；三项分别需要不同评价。'),
 slide('1.评价体系沿革','四层追问连接信息、几何与过程','分层评价框架',['编码里有没有信息？','信息是否组织成稳定、有意义的几何？','这个空间能否描述并预测过程？'],{kind:'diagram',nodes:['Decodability','Information Sufficiency','Semantic Geometry','Process / Law'],captions:['读出难度','信息保留','原生距离','轨迹与算子']},'本次评价框架；四层问题逐步加深，不宣称严格逻辑蕴含。Information Sufficiency 是选定任务下的操作定义。'),
 slide('1.评价体系沿革','传统编码与 latent space 进入同一评价','六种共同参照',['ZVector、GeoNorm、PCA-Geo','V2、RoPE-z、RoPE_geo+15%mask'],{kind:'diagram',nodes:['同一原始记录','传统编码 ×3','已训练模型 ×3','共同评价任务'],captions:['12,000 条','train-only 拟合','frozen checkpoint','四层协议']},'来源：latent_evaluation_benchmark/README.md。传统基线与模型维数、算子参数量不同，报告时同时展示。'),
 slide('1.评价体系沿革','共享样品与任务仍需交代数据暴露','评估协议',['新抽样 12,000 条，sample-ID hash 70/15/15','所有真实记录参加过原模型预训练；test 仅隔离探针拟合','目标组成字段在表示预处理前删除'],{kind:'diagram',nodes:['原始视图','train / val / test','目标遮盖','六种表示','同一评价'],captions:['270,241 条','70 / 15 / 15','先删除','各自预处理','按任务汇总']},'来源：latent_evaluation_benchmark/src/data.py、README.md。新 12,000 ID 与旧审计 12,000 ID 不直接相同。'),
 slide('2.Element2VecV2实战','V2 用元素身份和数值构建上下文 token','V2 架构',['元素身份 509D + 数值及两个 mask 标志','输入 MLP 投影到 768D；12 层 Transformer','本轮取最后层有效数值 token 的均值'],{kind:'diagram',nodes:['元素身份 509D','数值 z + mask','输入 MLP 768D','12 层 Transformer','数值 token 均值'],captions:['查表','训练对应标准化','token 化','上下文','样品表示']},'来源：stage3_5_element2vec_v2/src/models/element2vec_v2.py；latent_evaluation_benchmark/src/adapters/checkpoints.py。主要评价移除岩石标签 token。'),
 slide('2.Element2VecV2实战','RoPE 分支改变数值注入与遮盖条件','分支构建',['RoPE-z：z 坐标通过 Q/K 旋转注入数值','RoPE_geo：主量平方根、微量 log(C/PM) 等坐标，数值遮盖约 15%','三者均训练 50 epoch、13,200 optimizer step'],{kind:'diagram',nodes:['V2: 数值→MLP','RoPE-z: z→Q/K','RoPE_geo: geo→Q/K'],captions:['输入 token 改变','移除输入 MLP','坐标与 masking 同改']},'来源：两个 RoPE 分支报告、模型 checkpoint audit。RoPE-z 不是单独开关：输入 MLP 同时移除。geo 坐标和 mask 密度同改，不能归因于单一机制。'),
 slide('2.Element2VecV2实战','读出之前先去除目标相关输入','Decodability：目标构建',['rock_group、rock_origin 与 SiO₂、Mg#、ΣREE10','SiO₂、Mg#、REE 组成字段在预处理前遮盖','比较线性至三档 MLP 的读出能力'],{kind:'diagram',nodes:['原始记录','删除目标组成字段','表示编码','四档 probe','验证与 test'],captions:['真实标签','逐目标处理','固定编码','同预算','不同 split']},'来源：latent_evaluation_benchmark/src/data.py、src/probes/evaluate.py。ΣREE10 为数据库十个 REE 完整面板之和，Mg# 只用 MgO 与 FeO。'),
 slide('2.Element2VecV2实战','读出器复杂度揭示信息是否容易使用','四档 probe',['Linear、MLP32、MLP128_64、MLP512_256_128','相同学习率预算；验证集 early stopping','曲线横轴为实际参数量'],{kind:'image',path:B+'decodability_overview.png'},'来源：latent_evaluation_benchmark/outputs/decodability/metrics.csv。大 MLP 不保证更好；不同输入维数造成参数范围不同，不用 AUC 总排名。'),
 slide('2.Element2VecV2实战','类别易读出，化学恢复出现分化','Decodability 结果',['rock_group 线性平衡准确率：V2/RoPE ≈0.66，ZVector 0.54','遮盖 SiO₂ 后线性 R²：V2 0.951、RoPE-z 0.884、geo 0.849','遮盖 REE 输入后 ΣREE10 的 R² 接近零'],{kind:'image',path:B+'decodability_tasks/SiO2.png'},'来源：latent_evaluation_benchmark/REPORT.md、outputs/decodability/metrics.csv。模型预训练含全部记录和标签；此分数不是未见来源泛化。'),
 slide('2.Element2VecV2实战','共享随机遮盖检验已输入字段的信息保留','Information Sufficiency：遮盖恢复',['每条真实记录共享一份 20% 观测遮盖','linear Ridge 只评价被遮盖的有效字段','验证集选正则化，按字段报告 R²'],{kind:'diagram',nodes:['34 字段观测','随机遮盖 20%','六种表示','linear Ridge','原值恢复'],captions:['同一记录','同一 realization','原生预处理','val 选参','仅被遮盖字段']},'来源：latent_evaluation_benchmark/src/data.py、src/probes/evaluate.py。外部同位素和年龄从未进入 encoder，属于外部目标预测。'),
 slide('2.Element2VecV2实战','来源与测项模式可以成为可读信号','混杂信息检查',['data_source、最多 64 个文献引用','train 观测 mask 聚成 12 个缺失模式簇','reference 覆盖范围单独标注'],{kind:'diagram',nodes:['同一化学样品','来源标签','文献标签','测项 mask','三类读出'],captions:['输入','source','≥10 train','12 clusters','线性 probe']},'来源：latent_evaluation_benchmark/src/probes/evaluate.py。reference 标签限 train≥10 且最多64类；coverage 字段按全部记录计算。'),
 slide('2.Element2VecV2实战','信息恢复较强时仍须检查来源混杂','Information Sufficiency 结果',['V2 主量/微量字段中位 R²：0.646 / 0.354','三模型 source balanced accuracy：0.678 / 0.644 / 0.661','不能把岩石读出提升全部解释为地质信息'],{kind:'image',path:B+'sufficiency_vs_leakage.png'},'来源：latent_evaluation_benchmark/REPORT.md。负的 isotope 字段中位 R² 不支持可靠外部预测；ZVector/GeoNorm 显式输入 mask。'),
 slide('2.Element2VecV2实战','三元组直接检验指定属性的距离次序','Semantic Geometry：triplet',['锚点与属性近样品应比远样品更接近','连续目标尽量匹配 rock_group 和测项数','模型得分用原生 Euclidean，PCA 只属于基线或展示'],{kind:'diagram',nodes:['锚点 A','属性近 P','属性远 N'],captions:['指定属性 y','|yA−yP| 小','|yA−yN| 大']},'来源：latent_evaluation_benchmark/src/semantic/evaluate.py。低/高差值分位 0.2/0.8，测项数容差3；匹配失败回退次数有协议文件。'),
 slide('2.Element2VecV2实战','邻域图检验地质指标是否连续','图平滑度',['在 test 原生空间构建 k=20 邻域','计算邻接目标差的归一化图能量','100 次标签置换给出参照'],{kind:'diagram',nodes:['原生向量','k=20 邻域图','目标差能量','置换参照'],captions:['train RMS 尺度','test 样品','低值更连续','100 次']},'来源：latent_evaluation_benchmark/src/semantic/evaluate.py。连续属性仅在有效目标边上评估；triplet 使用 unmasked 输入。'),
 slide('2.Element2VecV2实战','信息可解码不保证原生距离更忠实','Semantic Geometry 结果',['SiO₂ triplet：ZVector 0.910，V2 0.859，RoPE_geo 0.798','Eu anomaly：GeoNorm/PCA-Geo 0.744，三模型约 0.65–0.67','旧 rock_type 余弦邻域与本轮任务不同'],{kind:'image',path:B+'semantic_geometry.png'},'来源：latent_evaluation_benchmark/REPORT.md；旧 RoPE 配对报告。新旧样本、岩石标签、余弦/Euclidean和评价器均不同。'),
 slide('2.Element2VecV2实战','局部响应是进入过程评价的起点','旧审计的启发',['V2 F2 方向一致性：FULL 0.395、PCA64 0.443、PCA32 0.457','RoPE 小扰动更规则，旧 rock_type 邻域下降','随机模型也能很平滑，因此还需过程规律检验'],{kind:'image',path:S+'pca_sweep/reports/figures/experiments/F2_single_element_jacobian_dimension_curve.png'},'来源：V2_TO_PRESENT_SYNTHESIS_ZH.md；RoPE-z 报告。F2 在34字段及预设背景下测量，不代表全空间本征维数。'),
 slide('2.Element2VecV2实战','每种表示消费同一条已保存物理轨迹','共享 EpisodeBank',['四种单过程各 2,000 条，复合过程 8,000 条','synthetic 与 semi-synthetic 单过程各半','全轨迹按 initial-state ID 归组'],{kind:'diagram',nodes:['初始岩石','物理参数','33 状态轨迹','六种表示','几何与算子'],captions:['合成/半合成','共享 seed','每过程2,000','同一 episode','成对比较']},'来源：latent_evaluation_benchmark/src/process_bank/episode.py。另有4条矿物固溶体校准，总16004个episode ID。'),
 slide('2.Element2VecV2实战','合成主量与半合成初值使用不同约束','初始岩石生成',['合成：矿物质量分数经化学计量得到主量','微量：train log 数据拟合 PCA 先验；REE 参数化曲线','半合成：完整合法主量面板的真实记录闭合至100'],{kind:'diagram',nodes:['矿物模态','氧化物主量','微量先验','REE 曲线','初始全岩'],captions:['Dirichlet正支撑','质量分数','train 拟合','外部字段扩展','合法状态']},'来源：latent_evaluation_benchmark/src/process_bank/rock_generator.py、trace_generator.py、episode.py。半合成 eligible pool 7096 条；外部字段并非全部模型输入。'),
 slide('2.Element2VecV2实战','浓度混合先提供一个可验证的直线参照','理想过程一：混合',['C(t)=(1−t)CA+tCB，t∈[0,1]','在原始线性 ZVector 中应接近直线','检验 encoder 是否把简单关系弯曲'],{kind:'image',path:R+'Mixing_raw_trajectory.png'},'来源：latent_evaluation_benchmark/src/process_bank/operators/mixing.py；冻结 EpisodeBank：Mixing_semi-synthetic_00978。图示主量与微量为保存的33状态。'),
 slide('2.Element2VecV2实战','分离结晶由主量预算与微量分配共同定义','理想过程二：分离结晶',['主量：受氧化物预算约束的随机矿物移除','微量：Cl=C0·F^(D−1)，F 从 1 到 0.1','D 为合成先验，未做相平衡校准'],{kind:'image',path:R+'Fractionation_raw_trajectory.png'},'来源：latent_evaluation_benchmark/src/process_bank/operators/fractionation.py、episode.py；冻结 EpisodeBank：Fractionation_synthetic_00662。单过程终点 F=0.1。'),
 slide('2.Element2VecV2实战','本轮部分熔融主要检验微量响应','理想过程三：部分熔融',['Cl=C0/[D+F(1−D)]，F 从 0.01 到 0.5','当前实现保持主量不变','F=0.01 首个熔体不是源岩，故不拼入复合边界'],{kind:'image',path:R+'PartialMelting_raw_trajectory.png'},'来源：latent_evaluation_benchmark/src/process_bank/operators/partial_melting.py；冻结 EpisodeBank：PartialMelting_semi-synthetic_00869。主量保持不变，微量随 F 改变。'),
 slide('2.Element2VecV2实战','理想蚀变采用稀疏乘性浓度变化','理想过程四：蚀变',['Ci(t)=Ci(0)·exp(t·ai)','约 30% 字段改变，REE 可共享扰动','不做事后闭合；不对应具名自然蚀变'],{kind:'image',path:R+'Alteration_raw_trajectory.png'},'来源：latent_evaluation_benchmark/src/process_bank/operators/alteration.py、episode.py；冻结 EpisodeBank：Alteration_synthetic_00252。'),
 slide('2.Element2VecV2实战','轨迹几何分别量化方向、直度与折叠','四种过程几何指标',['相邻位移方向余弦；端点距离/路径长','7 状态局部 rank-1；远步非邻近碰撞','零位移不记为完美平滑'],{kind:'diagram',nodes:['切向一致性','路径简单度','局部 rank-1','远步碰撞'],captions:['方向','直度','低维性','no-fold 启发式'],notes:'源：operators/metrics.py'},'来源：latent_evaluation_benchmark/src/operators/metrics.py。no-fold 为启发式，不等于拓扑嵌入证明。'),
 slide('2.Element2VecV2实战','给定过程参数后检验一步预测难度','条件线性算子',['dz/dt=Az+Bθ+b，Ridge 拟合全维表示','按初始状态 ID 隔离整条轨迹','同时报告归一化误差和参数数量'],{kind:'diagram',nodes:['当前 z','物理控制 θ','Ridge 向量场','下一步 ẑ','真实 z'],captions:['全维','过程已知','val选α','Euler推进','误差']},'来源：latent_evaluation_benchmark/src/operators/linear.py。此任务给出过程参数，不检验模型能否自行推断自然过程。'),
 slide('2.Element2VecV2实战','复合过程以前段预测终点继续推进','多阶段与顺序检验',['Mixing/Fractionation/Alteration 构成 2–3 段路径','边界处不注入真实中间 latent','AB/BA 只评估合法反序样本'],{kind:'diagram',nodes:['预测段 A','预测终点','预测段 B','终点误差'],captions:['当前 z','不重置','前段预测输入','真实对照']},'来源：latent_evaluation_benchmark/src/process_bank/composite.py、src/operators/evaluate.py。物理 trace semigroup 校验与 learned rollout 分开。'),
 slide('2.Element2VecV2实战','成对抽样区间约束结果确定程度','Monte Carlo 与区间',['episode ID 严格配对；重复自然初值聚类 bootstrap','CI 半宽目标 ≤0.02，最多扩至 8,000','35 项 composition-error 比较仍未达精度目标'],{kind:'image',path:B+'monte_carlo_convergence.png'},'来源：latent_evaluation_benchmark/src/statistics/paired.py、outputs/tables/precision_status.json。504 项探索性配对比较不是独立发现数量。'),
 slide('2.Element2VecV2实战','四类共享过程按顺序动态展示','过程动画',['混合 → 分离结晶 → 部分熔融 → 蚀变','六种表示消费相同物理状态','PCA3 仅供显示；计算仍在原生空间'],{kind:'video',path:R+'PartialMelting_median_frame016.png'},'内嵌视频：presentation_v2_evaluation/output/four_processes.mp4。每段使用预定义 GeoNorm simplicity 中位规则；PartialMelting 从冻结缓存补渲染。'),
 slide('2.Element2VecV2实战','过程收益取决于表示与具体定律','单过程结果',['RoPE_geo 四类一步误差均低于其余两个训练模型','ZVector 的混合基线接近零；GeoNorm 在部分过程较强','三个 encoder 都弯曲原本线性的混合'],{kind:'image',path:B+'process_operator_error.png'},'来源：latent_evaluation_benchmark/REPORT.md、outputs/process/operator_metrics.csv、outputs/tables/paired_statistics.csv。三模型算子参数量大于传统基线，不能称更简单。'),
 slide('2.Element2VecV2实战','复合推进没有统一优胜表示','复合与顺序结果',['异类终点误差中位：ZVector 0.224，geo 0.413，V2 0.666','顺序效应：模型 Spearman 约 0.43–0.55','反序合法率约 53–59%；细微名次受精度限制'],{kind:'image',path:R+'Composite_results.png'},'来源：latent_evaluation_benchmark/REPORT.md、outputs/composite/metrics.csv、noncommutativity.csv、order_coverage.csv。左图为test episode 中位误差，右图仅含合法反序样本；35项误差比较未达CI精度。'),
 slide('2.Element2VecV2实战','四层评价揭示互不等价的能力','结果综合',['信息容易读出，距离未必符合化学语义','过程预测改善可与信息恢复下降同时出现','目前不计算模型加权总分'],{kind:'diagram',nodes:['信息可读','信息保留','距离有意义','过程可预测'],captions:['类别↑','恢复分化','任务依赖','过程依赖']},'来源：latent_evaluation_benchmark/REPORT.md、旧V2与RoPE审计。此处不排列模型总体名次。'),
 slide('3.后续工作','当前框架仍是受控实验 DEMO','证据边界',['真实 test 参加过预训练；单训练 seed','过程定律理想化；半合成覆盖完整面板子集','若干 composition-error 区间未达精度'],{kind:'diagram',nodes:['已实现','有限验证','待补充'],captions:['统一协议','理想过程','外部真实过程']},'来源：latent_evaluation_benchmark/REPORT.md。模型预训练含全量样品与岩石标签。'),
 slide('3.后续工作','优先扩充任务、数据和过程验证','评价体系下一步',['按文献／地区隔离重新训练与评估','加入具名地质过程、外部数据与过程参数校准','匹配维数／算子参数量，增加 seed 与直接模型配对区间'],{kind:'diagram',nodes:['任务覆盖','独立数据','过程校准','统计重复'],captions:['更多目标','跨来源','自然约束','多seed']},'研究计划，依据现有局限；尚无相应实验结果。'),
 slide('3.后续工作','用评价反馈修正 Element2Vec 的设计','研究闭环',['补齐 z/geo × masking 的 2×2 消融','将信息保留、语义距离与过程目标共同纳入训练设计','新模型回到同一评价体系复测'],{kind:'diagram',nodes:['评价发现','机制假设','受控训练','统一复测'],captions:['定位缺口','分离效应','消融','检查权衡']},'研究计划，未执行。当前已有 z 单值遮盖与 geo 15% 数值遮盖；需补另外两格。'),
