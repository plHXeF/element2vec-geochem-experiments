import fs from 'node:fs';
export const data=JSON.parse(fs.readFileSync(new URL('./data.json',import.meta.url),'utf8'));
export const chapters=['我们希望得到怎样的地球化学表示','如何读取一份岩石样品','模型学到了什么','RoPE 分支','更完整地评价表示','目前的认识与下一步'];
const ROOT='@@WORKSPACE@@/';
const S=ROOT+'stage3_6_element2vec_space_exploration/';
const V=ROOT+'stage3_5_element2vec_v2/';
const B=ROOT+'latent_evaluation_benchmark/';
const BR='@@ROPE_SOURCE@@/';
const G=BR+'stage3_5_element2vec_v2/experiments/rope_geo_mask15/';
const SYN=S+'reports/V2_TO_PRESENT_SYNTHESIS_ZH.md';
export const slides=[];
function add(ch,title,sub,take,visual,speech,evidence,opts={}){slides.push({ch,title,sub,take,visual,speech,evidence,...opts});}
function agenda(ch,speech){add(ch,'汇报目录','', '',{kind:'agenda'},speech,[SYN,B+'REPORT.md']);}
const tbl=(headers,rows,widths)=>({kind:'table',headers,rows,widths});
const bars=(categories,values,label,opts={})=>({kind:'chart',chart:'bar',categories,series:[{name:label,values}],...opts});
const mn=['原值标准化','地化标准化','地化降维','V2','RoPE-z','RoPE-地化'];
const models=data.models;
function probe(target,metric='balanced_accuracy',name='Linear'){return models.map(m=>Number(data.probe.find(r=>r.target===target&&r.representation===m&&r.probe===name)[metric]));}
function curves(target,metric){let probes=['Linear','MLP32','MLP128_64','MLP512_256_128'];return {chart:'scatter',categories:[],series:models.map((m,i)=>{const rr=probes.map(p=>data.probe.find(r=>r.target===target&&r.representation===m&&r.probe===p));return {name:mn[i],values:rr.map(r=>Number(r[metric])),xValues:rr.map(r=>Math.log10(Number(r.parameter_count)))};}),xTitle:'读出器参数量（以 10 为底的对数）',yTitle:metric==='R2'?'恢复能力 R²':'平衡准确率',format:'0.00',legend:true,min:metric==='R2'?undefined:0,max:metric==='R2'?undefined:1};}

add(0,'地球化学表示：设计、实验与认识','Element2Vec V2 项目进展','V2 与 RoPE 分支 · 2026.09.17',{kind:'cover'},
'今天我想汇报的是，我们怎样尝试把一份岩石的元素含量，变成一个可以比较、也可能用来描述过程的向量。我会先介绍这个想法从哪里来，再介绍 V2 和 RoPE 分支的设计，接着展示实验给出的支持和反例，最后说明我们为什么逐步建立了新的评价体系。这里既有取得的进展，也有促使我修正想法的结果。大家不需要先熟悉这个项目，后面会从具体的样品和图形开始解释。',[SYN,B+'REPORT.md']);

agenda(1,'先从研究问题开始。看模型结构之前，我们需要明确为什么要把一张地球化学表格换成另一种表示，以及我们究竟希望这个空间具有什么性质。这一部分也会交代早期黄铁矿工作与后来全岩 V2 的关系。');
add(1,'同一份样品，可以有不同的数值表示','表示，就是选择一种组织信息的方式','换一种坐标，可能改变“谁和谁更接近”',
{kind:'representation'},
'假设我们手里有一份岩石样品，测到了二氧化硅、氧化镁和一些微量元素。最直接的办法，是把这些数按顺序排成一行。但主量元素通常以百分数报告，微量元素可能以百万分之一报告，而且浓度跨度很大。直接计算两行数的距离，往往会被少数数值较大的测项支配。所以，表示并不是模型才有的东西。取对数、按尺度标准化、换成元素比值，都是在重新组织同一份信息。接下来要问的是，这样组织之后，比较是否更有用。',[ROOT+'presentation_html/build_presentation.py'],{detail:false});
add(1,'传统方法已经在选择地质坐标','从含量、相对丰度，到元素组合','模型需要与这些已有方法共同比较',
tbl(['方法','直观含义','希望改善什么'],[['取对数／排序','把相差很大的浓度放到可比较的尺度','减少极端值的支配'],['参考组成标准化','看样品相对参考岩石富集或亏损多少','突出地球化学谱型'],['元素比值／元素组对比','看元素之间的相对关系','表达组合与过程线索']], [310,470,340]),
'在地球化学里，我们实际上早就经常使用不同坐标。取对数可以压缩很长的浓度尾部，参考组成标准化让富集和亏损更容易看出来，元素比值则强调相对关系。因此，这个项目的目标不是默认神经网络一定比传统处理更好，而是把传统方法也放在同一场比较里。只有知道它们本来已经能做什么，才有办法判断模型新增了什么，又牺牲了什么。这一点在后来的过程实验中尤其重要。',[ROOT+'presentation_html/build_presentation.py',ROOT+'stage2_geo_representation_xgb/outputs/stage2_report.md']);
add(1,'黄铁矿阶段：简单方法已是很强的对照','7,778 个样品 · 14 个元素 · 6 种矿床类型','邻域同类比例高，只回答了部分问题',
{kind:'chart',chart:'bar',categories:['排序标准化','对数标准化','元素比值','元素组对比','原值稳健标准化'],series:[{name:'相邻 15 个样品中的同类比例',values:[.9172,.9084,.8631,.8545,.7573]}],min:0,max:1,format:'0%',yTitle:'邻域同类比例（越高越好）'},
'最早的比较使用黄铁矿数据。这里的柱子表示，找到一个样品周围最近的十五个邻居后，有多少邻居属于相同矿床类型。排序和取对数这样的简单处理已经表现很好，加入人工地质比值或元素组对比，并没有在这个指标上全面胜出。这提醒我，不能只因为一种表示听起来更有地质含义，就认为它一定更好。同时，同类样品靠得近也可能受到文献来源和检测面板的影响。后面切换到全岩数据时，样品和标签都变了，因此两阶段的分数不能直接串成性能提升曲线。',[ROOT+'stage2_geo_representation_xgb/outputs/stage2_report.md',ROOT+'presentation_html/assets/tables/unsupervised_metrics.csv']);
add(1,'我们希望空间中的距离和方向有含义','“近”对应相似；“移动”对应可解释的变化','需要检验空间的组织方式，而不只检验分类结果',
{kind:'geometry'},
'这里把表示想成一张地图。地图上的位置是模型为样品安排的一组坐标，它的维度通常远高于我们能画出来的二维图。我们希望地质属性相近的样品，在某种明确的意义下也更接近；如果元素组成按照一个过程连续变化，希望对应的坐标变化也有可解释的规律。但岩性、来源、熔融程度并不是同一个属性，不一定能共享一条简单距离。因此，“空间有意义”需要拆成具体问题，分别检查。图上的点只是概念示意，后面实际分数都来自各自规定的空间。',[SYN,B+'README.md']);
add(1,'Word2Vec 给出的启发：关系也可以用向量表达','词向量关系示意；此图不是实测投影','相似关系，是否能表现为近似一致的位移？',
{kind:'analogy',mode:'words'},
'自然语言中的词向量提供了一个直观启发。把词放进一个坐标空间后，我们除了比较两个词是否相近，还可以比较词之间的关系。这里用国王、女王、男人和女人画一个理想化示意：如果两组关系对应相近方向，就可以用向量运算表达这种联系。这个示意并不意味着所有词都满足精确等式，也不是重新计算的词向量结果。对我们有启发的是研究方式：不仅问单个对象放在哪里，还问不同对象之间的关系，能不能形成可重复的空间结构。',['https://arxiv.org/abs/1301.3781'],{extra:'图中的坐标为教学示意。向量类比在具体词表、训练数据与检索规则下评价，不能把二维示意当作高维模型的数值验证。'});
add(1,'岩石之间，会有类似的关系方向吗？','玄武岩 − 辉长岩 ≈ 流纹岩 − 花岗岩？','这是待检验的类比，不是已经成立的实验结论',
{kind:'analogy',mode:'rocks'},
'把同样的想法放到地质对象上，就可以提出图中这个问题。玄武岩和辉长岩、流纹岩和花岗岩，分别提供了火山岩与深成岩的对应关系。我们可以问，这两组对应关系在模型空间里，是否表现为近似一致的方向。这里的减号表示坐标差，不是在说把一块辉长岩直接变成玄武岩，也不代表它们来自同一条自然演化路径。后面的实验确实检查了标签关系和样品空间，但目前证据还不足以支持一个普遍成立的地质向量算术体系。',[SYN,S+'results/G2_volcanic_plutonic_analogy/metrics.json'],{extra:'概念图只表达研究假设。后续引用标签向量、样品质心或样品向量时，必须区分表示层级；它们不能直接互换。'});
add(1,'早期评价是一张多维能力图谱','预测、邻域、聚类，以及尚待完善的指标','这些维度有用，但它们回答的问题并不处在同一层次',
{kind:'capabilities'},
'最开始，我把表征评价看成一个多维的能力画像，主要包括预测有效性、局部邻域、全局结构、信息保真、地质指标连续性和泛化稳定性。黄铁矿阶段主要量化了前三项。但后来发现，这些维度混合了不同层次的问题，而且一个简单的原始地球化学向量本身就可能在不少指标上表现很好。所以，后面我逐步把问题改成：信息是否容易读取，是否保留了选定任务需要的信息，距离是否合理，以及过程能不能被描述和预测。我们先看模型和实验，再回到这个评价框架为什么发生变化。',[ROOT+'presentation_html/assets/figures/six_dimension_framework.svg',ROOT+'presentation_html/build_presentation.py']);
add(1,'项目的几轮工作各自解决不同问题','黄铁矿探索之后，V2 成为独立全岩主线','实验登记数量，不等于独立发现数量',
{kind:'timeline',items:[['黄铁矿','比较传统表示'],['全岩 V2','统一编码不同测项'],['空间探索','检查信息与几何'],['RoPE 分支','改变数值进入方式'],['统一评价','比较信息、距离与过程']]},
'这张图给出整场汇报的位置。早期黄铁矿工作建立了比较不同表示的思路。V2 随后转向更大规模的全岩数据，用可变数量的信息单元来处理不完整测项。接着，我们进行了广度探索、不同维度的重复比较和更严格的投影对照。RoPE 分支改变了数值进入模型的位置，而最新评价则把六种表示放进相同的真实样品任务和过程轨迹中。每一轮都在回答上一轮留下的问题。后面出现的五十项登记和大量重复测量，不应被理解成同样数量的独立地质发现。',[SYN,B+'REPORT.md']);

agenda(2,'现在进入 V2。前面已经明确，我们希望得到的不只是一个分类输出，而是一种可复用的样品表示。接下来我会用一份具体的样品，解释数据怎样进入模型，以及训练时究竟要求模型做什么。');
add(2,'V2 面对的是测项不齐的全岩样品','270,241 个样品 · 34 个数值字段','全岩 V2 与早期黄铁矿使用不同的数据和标签',
{kind:'dataset'},
'V2 使用的全岩视图有二十七万多个样品和三十四个数值字段，其中包括主量氧化物、微量元素，以及少量辅助测项。现实数据的一个特点是，不同样品并不都测了同样的元素。除了数值，训练数据还可能带有岩石大类、成因类别和岩石名称等标签。V2 的设计从这个现实出发：一份样品提供多少有效观测，就生成多少对应的信息单元。图中数字用于说明数据规模，而不是说明每条记录都拥有全部字段。',[V+'README.md',S+'audit/data_audit.md',SYN]);
add(2,'测到了什么，就输入什么','两个教学样品展示不同的测项组合','缺测字段不生成有效信息单元；顺序不承担地质含义',
{kind:'tokens'},
'可以把每个测项想成一张小纸条，上面写着“这是什么元素或氧化物”和“测到了多少”。第一个样品可能有硅、镁、铷、锶，第二个样品少了铷但多了镍。模型接收的是这组纸条，而不是要求每个位置必须有一个观测。训练时还会打乱这些信息单元的顺序，避免模型把某个固定列号误当成元素身份。不过，顺序不敏感和缺测不敏感是两回事。后面的实验会看到，删除一批已测元素，仍然可能明显改变样品向量。',[V+'README.md',SYN],{extra:'图中测值是教学示例，不来自单个真实样品。计算时可用填充位置组成批次，但无效位置由注意力标记排除。'});
add(2,'一个信息单元同时说明身份和数值','先分清“是什么”，再表达“有多少”','509 维身份＋1 个数值＋2 个遮盖标志，组成 512 维输入',
{kind:'token'},
'以铷这个测项为例，模型需要同时知道它是铷，以及它的含量。V2 为元素身份准备一组可以学习的数字，再把标准化后的数值和两个遮盖标志拼进去。身份向量有五百零九维，加上三个数形成五百一十二维输入。这里的维数只是实现选择，并没有证据表明五百零九这个数字本身具有特殊地质意义。随后，一个共享的小型神经网络把它变成七百六十八维表示。这个阶段主要整合本测项的身份与数值，还没有读取整份样品中其他元素的背景。',[V+'src/models/element2vec_v2.py',V+'src/models/token_projector.py']);
add(2,'V2 架构：多个输入汇合，多个任务分开','本页同时区分训练输出与样品表示','元素间的信息交换发生在 Transformer 内部',
{kind:'v2architecture'},
'这张图把 V2 的主要结构展开。左侧的元素身份、数值和遮盖标志是同时汇合的，不是依次加工的三个步骤。输入网络处理每个信息单元后，十二层 Transformer 让这些单元彼此交换信息。训练时，模型根据本次遮盖的内容选择相应输出头，预测数值、字段名或岩石标签。评价时则走另一条路径：移除岩石标签输入，把最后一层有效数值单元的表示取平均，得到整份样品的向量。先把这两条路径区分开，后面才不会把训练分类器的输出和样品空间混为一谈。',[V+'src/models/element2vec_v2.py',B+'src/adapters/checkpoints.py']);
add(2,'注意力：同一个元素会参考同样品中的其他元素','谁值得参考，由当前信息共同决定','输出的铷表示，可能包含整份岩石的化学背景',
{kind:'attention'},
'注意力可以先理解为一种有条件的信息汇总。比如更新铷的表示时，模型会根据当前输入，决定在多大程度上参考锶、硅、镁等其他测项，再把这些信息组合起来。经过多层这样的处理，输出就不再只是“铷加上一个数值”，还可能包含这份岩石整体偏基性还是偏酸性等背景。这是后面上下文实验的直接动机。不过，注意力权重本身不是因果证明。模型愿意参考一个测项，不代表我们已经发现了该元素控制另一元素的地质机制。',[V+'src/models/transformer_encoder.py',SYN]);
add(2,'训练像三种填空题，每份样品随机选一种','隐藏数值、隐藏字段名，或隐藏岩石标签','利用其他可见信息，预测被遮住的部分',
{kind:'masktrain'},
'模型不是只做一种填空题。第一种保留铷的名字，遮住它的含量；第二种保留数值，遮住字段名；第三种遮住一个岩石标签。这三类任务按设定概率随机分配，V2 默认分别是百分之四十五、十五和四十。每次只执行对应的任务，因此图上是分支，而不是让每份样品连续经过三次预测。由于训练使用了岩石标签，这是一种混合监督训练。以后即使在评价输入中移除标签，也不能说模型从来没有接触过这些标签。',[V+'README.md',V+'configs/v2_base.yaml']);
add(2,'训练时用标签，评价时移除标签输入','最新统一评价只提取化学信息单元的均值','移除直接标签输入，不能抹去模型的训练经历',
{kind:'traininfer'},
'这里再单独强调一次训练和评价的区别，因为它直接影响结果怎么解释。训练时，模型读过全部现有样品，也通过任务接触过岩石标签。最新评价时，我们把标签信息单元全部移除，只使用化学观测，最后取有效数值单元的平均表示。这样避免了把答案直接作为输入，但预训练权重仍然包含此前学习的经历。所以当前真实样品实验适合检查固定表示中有什么、是否好读，并不能作为未见地区或未见文献的泛化成绩。真正的外部验证需要在预训练之前就隔离数据。',[B+'README.md',B+'src/adapters/checkpoints.py'],{detail:true});
add(2,'数值先换到各字段可比较的尺度','主量与微量的跨度不同，因此处理不同','V2 的训练坐标，不等于后面新增的“原值标准化”对照',
tbl(['输入类型','V2 的处理','直观目的'],[['主量氧化物','按字段中心与四分位距缩放','避免量纲与典型幅度支配计算'],['微量元素','先取 log₁₀，再按字段稳健缩放','压缩长尾与跨数量级差异'],['缺测／训练遮盖','缺测无有效单元；遮盖保留任务标志','区分没有观测和有意隐藏']], [240,470,410]),
'数值进入网络之前，需要做与训练对应的变换。主量氧化物直接做稳健尺度处理，微量元素先取对数，再做缩放。这样，一种典型范围很大的元素就不会只因为数值大而支配输入。这里有一个容易混淆的地方：后面评价中的“原值标准化”基线，用的是评价训练集的均值和标准差；它不等于 V2 训练时保存的这套坐标。地化标准化基线也不等于 RoPE 分支的地化坐标。它们名称接近，但具体做法不同，比较时必须各自按定义执行。',[V+'README.md',B+'src/representations/baselines.py'],{detail:true});
add(2,'当前可核实的 V2 训练为 50 轮','13,200 次参数更新；固定训练探针用于观察收敛','训练损失下降说明任务拟合改善，还需要检查表示本身',
{kind:'chart',chart:'line',categories:data.training.filter((r,i)=>i%2===0).map(r=>r.step),series:[{name:'固定训练样品的总损失',values:data.training.filter((r,i)=>i%2===0).map(r=>Number(r.probe_total_loss))}],yTitle:'损失（越低，训练任务拟合越好）',xTitle:'参数更新步数',min:0,format:'0.0'},
'当前日志能确认，V2 完成了五十轮训练，对应一万三千二百次参数更新。这里用固定样品、固定遮盖的训练探针看趋势，减少随机任务变化带来的噪声。曲线明显下降，说明模型能够更好地完成训练题目，但这些样品仍属于训练数据，不是独立验证集。旧分析文档里曾出现不同步数的描述，本次以当前日志为准。接下来我们暂时离开损失曲线，直接检查模型形成的元素表示和样品空间，看看它们到底发生了什么。',[V+'outputs/logs/probe_log.csv',V+'outputs/logs/train_log.csv',SYN]);

agenda(3,'这一部分介绍 V2 训练之后的空间探索。实验比较多，我不会按编号逐项罗列，而是围绕几个问题来讲：元素表示是否带上样品背景，空间里的变化是否有规律，哪些结构可能来自数据来源，以及降维之后我们还能相信什么。');
add(3,'空间探索覆盖了哪些问题','50 项登记包含有效结果、不可检验项和技术失败','先广泛寻找线索，再用针对性对照收紧结论',
{kind:'exploremap'},
'第一轮登记了五十项实验，范围从静态元素身份、数值编码，一直到岩石标签、理想过程、矿物代理和鲁棒性。图中把它们合并成六组问题，而不是五十个孤立的小结果。随后又做了不同维数的扫描，以及加入随机投影等对照的严格复验。这里必须区分“登记过”和“有效验证过”：比如检出限信息没有保留，就无法检验相应假设；某些算法运行失败，也不能解释成不存在相应结构。下面选取最能改变研究判断的结果。',[SYN,S+'reports/experiment_summary.csv']);
add(3,'输出元素表示能读出整份样品的背景','固定目标元素的近似含量，比较上下文化前后','背景信息确实进入了元素表示',
bars(['只融合身份和数值','参考其他元素之后'],[data.context.C1_same_value_context.mean_projected_score,data.context.C1_same_value_context.mean_contextual_score],'背景分类平衡准确率',{min:0,max:1,format:'0%',yTitle:'基性／中性／酸性背景识别'}),
'最直观的一组实验，是把目标元素的含量控制在相近范围，再问它的表示能不能区分样品来自基性、中性还是酸性背景。如果只有这个元素的身份和数值，识别能力比较有限；参考其他元素之后，平均平衡准确率从约百分之四十二提高到百分之九十四。这支持了一个明确结论：Transformer 输出的单个元素表示里，已经写入了整份样品的背景。但它还不能证明模型创造了原始化学数据中没有的新知识，因为模型本来就读到了其他元素。这个问题需要更强的对照。',[S+'results/C1_same_value_context/metrics.json',SYN]);
add(3,'补上全化学对照后，优势明显缩小','比较对象决定我们能声称多少增量','背景编码成立；“新地质角色信息”尚无支持',
{kind:'dualchart',left:{...bars(['全部化学输入','上下文元素表示'],[.8396565755,.9400944394],'背景识别',{min:0,max:1,format:'0%' }),title:'背景分类：仍有约 10 个百分点增量'},right:{...bars(['全部化学输入','上下文元素表示'],[.8533796825,.8285870916],'角色代理识别',{min:0,max:1,format:'0%'}),title:'元素角色代理：原化学对照更高'}},
'因此，我们给刚才的实验补了一个更公平的比较：直接用整份化学输入做同样的背景识别。这样，模型的优势从五十多个百分点缩小到约十个百分点。右边是另一组实验，尝试读出由化学指标构造的元素角色代理。加入全化学对照之后，模型反而略低。这两组结果不是互相矛盾，而是在收紧解释：背景信息确实被整理到了元素表示里，但不能把每一次读出成功都称为新增地质知识。后续每次展示提升，都需要把比较对象说清楚。',[S+'results/X1_context_raw_control/metrics.json',S+'results/X2_role_raw_control/metrics.json']);
add(3,'静态元素向量尚未形成清晰的周期语义','元素身份、上下文元素表示、样品向量是不同层级','最明显的能力出现在读取样品背景之后',
tbl(['检查内容','已有结果','当前解释'],[['周期／化学性质读出','相对初始化平均 R² 增量约 +0.0035','新增优势很小'],['预设相近元素对','12 对中只有 7 对可测','现有结果不支持明显亲和分组'],['稀土元素顺序','只有 La、Ce、Nd、Yb 四种输入','不足以检验完整稀土序列']], [320,390,410]),
'与上下文结果相比，静态元素身份向量的结果要弱得多。用它预测一些近似周期或化学性质，相比初始化向量的平均增量很小；预设相近元素对的检查也没有给出明确优势。稀土序列的问题更直接：模型输入词表里只有四种稀土元素，不足以验证完整排序。这说明不能把“元素表示”笼统当作同一种对象。查表得到的身份向量，与结合了整份样品背景的输出向量，其能力很不一样。现阶段更有证据的线索来自后者。',[SYN],{detail:true});
add(3,'轻微改变一个元素，观察样品坐标怎样移动','同一元素在不同岩石背景中接受相同规定扰动','方向一致性检验的是受控响应，不是自然因果关系',
{kind:'perturb'},
'另一个思路是主动改变输入。我们选定一个元素，让它的标准化数值增加一个规定幅度，其余输入保持不变，然后比较样品向量移动的方向。再把这个操作放到基性、中性和酸性背景中，看看同一个元素的作用方向是否相近。这样的受控扰动比只看一张散点图更具体，因为我们知道改了什么。需要注意，这还不是一个完整自然过程：真实岩石变化常常涉及多个元素、质量平衡和矿物变化。因此，这里的结果首先说明模型对输入怎样响应。',[SYN,S+'pca_sweep/reports/pca_dimension_sweep_report.md']);
add(3,'多个元素一起变化时，方向近似可加','实际联合位移，与各单元素位移之和比较','方向接近，但仍有明显的非加性分量',
{kind:'addition',cosine:.942,residual:.374},
'如果未来想做向量运算，还需要检查几个元素一起变化时，会不会等于它们分别变化的效果相加。实验比较了四类多元素联合扰动。结果显示，预测合成方向与实际方向的余弦约为零点九四，说明方向比较接近；但残差比例仍约为零点三七，说明位移并没有严格相加。这里同时看方向和误差很重要。只看一个很高的方向相似度，容易忽略长度和背景依赖的差异。因此目前只能说存在局部近似可加的线索。',[SYN],{detail:true});
add(3,'二维图无法代表完整表示的能力','比较同一批实验在不同维数下的指标保留情况','64 维是候选工作尺度，不能称为普适本征维度',
{kind:'chart',chart:'bar',categories:['64 维','32 维','2 维'],series:[{name:'接近完整空间的主指标比例',values:[34/44,29/44,11/44]}],min:0,max:1,format:'0%',yTitle:'44 项可比实验中的保留比例'},
'为了知道哪些信息集中在较低维度，我们把原实验放到不同的 PCA 维数下重复比较。在四十四项主要可比实验中，六十四维有三十四项主指标接近完整空间，三十二维是二十九项，而二维只有十一项。这个比例不是分类准确率，也不是解释了多少方差，而是按预设容差统计有多少实验大体保留表现。因此，二维或三维适合用来展示，却不能替代完整空间上的证据。六十四维可以作为一种候选工作尺度，但不能因此说地球化学本来就只有六十四个有效维度。',[S+'pca_sweep/reports/dimension_summary.csv',SYN]);
add(3,'更严格的投影对照，只保留了较窄的增强证据','单元素跨背景响应：完整空间、PCA64、PCA32','结论限定在三个预设背景与 34 个字段的有限差分实验',
{kind:'dualchart',left:{...bars(['完整空间','PCA 64维','PCA 32维'],[.3950,.4433,.4572],'跨背景方向余弦',{min:0,max:.6,format:'0.00'}),title:'降维后，方向一致性提高'},right:{kind:'facts',items:[['PCA64 增量','+0.0483','95% 区间 [0.0325, 0.0641]'],['PCA32 增量','+0.0622','95% 区间 [0.0349, 0.0893]']],foot:'同时比较同维随机投影；不是独立重训区间'}},
'接着，我们追问：降维后的提升是否只是随便压缩一下就会出现？因此加入了每个维数的多组随机正交投影，以及白化、去除主成分等对照。更严格复验后，最有依据的是单元素跨背景响应这一项：从完整空间的零点三九五，提高到六十四维的零点四四三和三十二维的零点四五七。右边给出相对完整空间的配对区间。但这个区间来自字段重采样，并不是多次独立训练。因此更准确的说法是，这个固定模型在这一受控任务里出现了响应一致性改善。',[S+'subspace_audit/reports/subspace_exploration_report.md',SYN]);
add(3,'降到很低维时，地质和来源结构都会减少','同一补充诊断中的邻域纯度；各类标签分别理解','来源分数下降，并不自动等于保留了更纯的地质信息',
{kind:'chart',chart:'line',categories:['完整空间','64维','32维','3维','2维'],series:[{name:'地质邻域',values:[.6471,.6459,.6420,.5371,.4952]},{name:'来源邻域',values:[.3634,.3632,.3550,.1885,.1556]},{name:'缺测模式邻域',values:[.6055,.6038,.5935,.4574,.3888]}],min:0,max:.8,format:'0%',yTitle:'同类邻居比例',legend:true},
'同一批样品的补充检查显示，压到二维或三维之后，来源和缺测模式的聚集确实降低了，但地质邻域也同时变弱。因此不能只因为来源分数下降，就说我们提纯出了地质信息。不同标签的类别数和机会水平也不同，不能简单把地质纯度减去来源纯度，解释成“纯地质含量”。此外，缺测与来源方向在高方差主成分里非常集中，而部分化学扰动分布在更低方差的方向。保留最大方差，并不天然等于保留最有用的化学响应。',[SYN,S+'subspace_audit/results/S/direction_energy_summary.csv'],{extra:'该补充诊断与 RoPE 旧审计的来源标签、采样和邻域口径不同，不跨表比较绝对分数。'});
add(3,'顺序稳定，缺测却仍然可能造成很大变化','同一个 V2 表示，接受两种不同输入操作','适应可变测项的架构，并不自动保证缺测鲁棒性',
{kind:'dualchart',left:{...bars(['打乱输入顺序','随机删除 30% 测项'],[1,.329],'操作前后向量余弦',{min:0,max:1,format:'0.00'}),title:'向量相似度：两个问题的结果不同'},right:{kind:'facts',items:[['顺序改变','几乎不变','符合无普通位置编码的设计'],['观测减少','明显变化','信息损失与测项模式都可能影响表示']],foot:'删除测项与自然缺测机制仍有差别'}},
'模型设计允许不同数量的输入，也不依赖元素排列顺序。实验验证，打乱顺序后的向量余弦相似度接近一，这符合设计预期。但随机删除百分之三十的信息单元之后，余弦只剩约零点三三。这说明“不要求固定列位置”与“丢测项后依然可靠”是两件不同的事。删除元素既减少了化学信息，也改变了测项组合，而测项组合本身可能与文献来源相关。因此，后续需要更接近实际分析面板的缺测实验，比如只有主量、缺少稀土组，或缺少某类微量元素。',[SYN]);
add(3,'样品空间与岩石标签空间尚未自然对齐','标签内部有些结构，不能直接替代样品中的关系','研究愿景需要继续保留，但不能提前写成结论',
tbl(['检验','已有结果','能说明什么'],[['样品向量直接检索岩石标签','首位命中率约 2.33%','没有形成实用的直接对齐'],['学习简单映射后留一类别检索','75 类中首位命中率约 5.33%','简单映射尚未解决问题'],['火山—深成标签关系','7 对可测，方向一致性约 0.652','有局部线索，且对投影敏感']], [430,335,355]),
'最后回到前面那张岩石类比图。标签向量内部确实出现了一些关系线索，但如果拿样品向量直接去找对应岩石标签，首位命中率只有约百分之二点三。学一个简单映射之后，留一类别的命中率也仍然很低。因此，标签之间的方向关系不能直接搬到样品空间里解释。更完整的结论是：V2 已经组织了可读的背景信息，并形成部分局部响应结构，但通用地质语义、样品与标签统一对齐，以及大幅度向量运算，都还没有得到充分支持。',[SYN],{detail:false});

agenda(4,'前面发现，V2 有上下文能力，但空间响应和地质组织还不够理想。接下来介绍 RoPE 分支：我们尝试改变数值进入模型的方式，看看能否让浓度变化更直接地影响元素之间的信息交换。随后会把改进与代价放在一起看。');
add(4,'为什么尝试改变数值进入模型的位置','V2 先把身份和数值混合，再进行注意力计算','RoPE 分支尝试让数值直接参与 Q/K 的比较',
{kind:'inputcompare'},
'在 V2 中，元素身份和数值先经过输入小网络混合，再送入注意力。我们提出一个新的设计问题：能否把元素身份保留为主要输入，而让数值以另一种连续方式直接影响注意力匹配？RoPE 原本用于把位置编码进注意力，这个分支借用旋转机制，把连续数值坐标作为旋转的控制量。这里注入的是数值，不是元素在输入列表里的先后位置。这个改动带有明确的几何动机，但是否能改善地质表示，需要后面的实验来回答。',[G+'REPORT.md',BR+'stage3_5_element2vec_v2/src/models/element2vec_v2.py','https://arxiv.org/abs/2104.09864']);
add(4,'拆开一层 Transformer，看数值在哪里进入','Q/K 决定如何匹配，V 提供被汇总的信息','数值旋转作用于 Q/K；前馈网络和残差连接仍然保留',
{kind:'ropeblock'},
'把一层 Transformer 放大后，输入会形成 Q、K、V 三条支路。可以粗略地把 Q 理解成当前单元要寻找什么，把 K 理解成其他单元提供什么匹配线索，把 V 理解成真正用于汇总的信息。RoPE 分支用数值坐标旋转 Q 和 K，再计算注意力权重，并据此加权汇总 V。图中另一条旁路是残差连接，后面还有前馈网络。我们删除的是 V2 最前面的输入融合网络，并没有把整个 Transformer 里的神经网络都删掉。另外，V 不直接接受这次旋转，但会随着层间的信息交换间接受到数值影响。',[BR+'stage3_5_element2vec_v2/src/models/transformer_encoder.py',BR+'stage3_5_element2vec_v2/src/models/element2vec_v2.py']);
add(4,'旋转编码：用角度影响元素之间的匹配','二维旋转只是其中一个分量的教学示意','模型实际同时使用多个不同频率的旋转分量',
{kind:'rotation'},
'旋转这件事可以先用一个小圆来理解。同一个方向向量，随着数值改变而转过不同角度，两组向量的匹配结果也随之改变。但真实模型不是只用这一只钟表，而是同时使用很多不同频率的旋转分量。因此，不能说最快的分量转过一圈，整个模型就精确回到原位。另一个限制是，旋转使用的坐标如果经过了标准化，共同增加一个标准化单位，并不等于所有元素浓度同比例增加。这些细节会影响我们怎样解释它的几何性质。',[BR+'stage3_5_element2vec_v2/src/models/transformer_encoder.py',G+'REPORT.md'],{detail:true});
add(4,'三个模型究竟改了什么','相同全岩数据与训练步数；输入和遮盖规则有差异','RoPE-地化版同时改变坐标与遮盖密度',
tbl(['模型','数值进入方式','数值坐标','数值任务遮盖'],[['V2','输入小网络融合','原训练标准化坐标','单个数值'],['RoPE-z','Q/K 旋转；移除输入小网络','原训练标准化坐标','单个数值'],['RoPE-地化','Q/K 旋转','主量平方根；微量 log(C/PM) 等','约 15% 观测数值']], [170,350,380,220]),
'这张表把三个模型放在一起，避免只记住它们的名字。V2 用输入网络融合数值；RoPE-z 改成 Q/K 旋转，同时去掉输入网络；RoPE-地化版进一步换了数值坐标，并把数值任务的遮盖量提高到约百分之十五。其中主量在满足条件时先做闭合，再用平方根质量分数，微量主要使用相对原始地幔的对数浓度。由于每一步都不止一个因素变化，当前结果只能评价这些具体方案，不能把所有差异单独归因于 RoPE、地化坐标或者遮盖密度。',[SYN,G+'REPORT.md',S+'reports/INPUT_TRANSFORM_CHECK_ZH.md']);
add(4,'训练完成，并不意味着三种损失可以直接排名','三模型均完成 50 轮、13,200 次参数更新','任务尺度和遮盖目标不同，低损失不等于空间更好',
{kind:'facts',items:[['共同预算','50 轮','当前完成的三套模型'],['RoPE-地化数值遮盖','约 15%','只在数值任务中启用'],['主量闭合适用范围','59.68%','其他记录执行配置中的回退规则']],foot:'固定训练探针仍是训练样品；主量与微量损失尺度不同'},
'三套模型都完成了相同数量的参数更新，RoPE-地化版也不是一个未训练完成的草稿。训练记录还确认，数值任务实际遮盖比例接近百分之十五。但模型使用的坐标、目标尺度和每次遮盖数量不同，所以不能把损失数字直接放在一起排名。地化版在几类数值目标上都优于每元素常数预测，说明它有学习；然而主量目标本身的尺度比较小，损失也会随之变小。真正要判断设计有没有帮助，还得回到相同样品和受控输入下的表示比较。',[G+'REPORT.md',SYN],{detail:true});
const qq=['v2','rope','geo'].map(k=>data.quality.find(r=>r.model===k));
add(4,'旧配对审计中，岩石近邻表现逐步下降','同一 4,000 样品池 · 仅化学输入 · 完整空间 · k=15','局部设计改动没有换来更强的整体岩石邻域',
{kind:'chart',chart:'bar',categories:['V2','RoPE-z','RoPE-地化'],series:[{name:'岩石类型同类邻居比例',values:qq.map(r=>Number(r.rock_type_purity))},{name:'相同来源邻居比例',values:qq.map(r=>Number(r.data_source_purity))}],min:0,max:.8,format:'0%',yTitle:'邻域比例；来源聚集是风险提示',legend:true},
'在同一套旧审计样品上，V2 的岩石类型邻域纯度约为百分之四十七，RoPE-z 降到百分之三十八，地化版进一步降到百分之三十一。与此同时，来源聚集却逐步增强。这个趋势不是只在某一张低维图里出现：不同池化方式、六十四维和三十二维投影，都没有逆转主要差距。因此，从这套旧任务看，V2 仍是三者中更好的整体岩石表示对照。这里评价的是较细的岩石类型近邻，后面新版评价的岩石大类读出是另一项任务，两者不能直接拼接。',[G+'quality.csv',G+'quality_paired_ci.csv',G+'REPORT.md']);
add(4,'小幅扰动的局部预测误差却更低','相同可接受物理输入；h=0.1，细步长参考 h=0.005','RoPE-地化的局部改善，限定在测试过的尺度',
{kind:'dualchart',left:{...bars(['V2','RoPE-z','RoPE-地化'],[.2464,.1935,.0992],'局部预测相对误差',{min:0,max:.3,format:'0.00'}),title:'误差降低：0.246 → 0.194 → 0.099'},right:{...bars(['V2','RoPE-z','RoPE-地化'],[.025,.05,.1],'满足预设条件的测试半径',{min:0,max:.12,format:'0.000'}),title:'合格局部半径：0.025 → 0.050 → 0.100'}},
'与岩石近邻下降形成对照的是，小幅扰动的局部响应变得更规则。在同样筛选后的物理输入上，用很小步长估计当前方向，再预测一个稍大变化，地化版的相对误差低于 V2 和 RoPE-z。满足预设误差和方向条件的测试半径，中位数也逐步扩大。这里的 h 由原 z 坐标定义共同物理扰动，不是让三个模型各自随意改变零点一个角度单位。改善也不能外推到所有尺度：扰动很大时，地化版的联合残差反而可能超过 RoPE-z。',[G+'REPORT.md',G+'fine_steps_summary.csv',G+'linearity_summary.csv']);
add(4,'更稳定的向量，也可能更少区分岩石背景','同一原始元素值下的背景读出仍存在，但变弱','需要同时检查稳定性与信息保留',
{kind:'dualchart',left:{...bars(['V2','RoPE-z','RoPE-地化'],[.9233,.9080,.8409],'背景识别平衡准确率',{min:0,max:1,format:'0%'}),title:'背景信息仍可读，但能力下降'},right:{...bars(['V2','RoPE-z','RoPE-地化'],[.621,.654,.735],'删除 10% 测项后的向量余弦',{min:0,max:1,format:'0.00'}),title:'删除测项后更接近原向量'}},
'还有一组结果可以帮助理解这种取舍。把目标元素的原始含量固定之后，三个模型都能读出背景，但地化版的背景分类分数更低。另一方面，删除百分之十的测项后，它的向量与原向量更接近。如果只看后一项，会以为模型更稳健；但同一缺测条件下，它的岩石识别仍然较弱。因此，一个表示“不太变化”，可能是更稳定，也可能是少保留了一部分差异。我们需要检查它稳定的同时，还能不能区分我们真正关心的对象。',[G+'REPORT.md'],{detail:true});
add(4,'哪些机制解释，目前还只是线索','共同标准化平移、真实浓度缩放、坐标压缩要分开','不能从某个现象直接锁定全局退化的原因',
tbl(['观察','容易产生的误解','目前更准确的解释'],[['共同 z 平移响应很小','已经学会浓度比例不变性','各元素尺度不同；并非共同浓度缩放'],['某些主量旋转差很小','周期旋转导致精确重复','更像坐标压缩，尚未证明因果'],['随机模型局部更平滑','越平滑越懂地质','随机模型的岩石邻域也更差']], [325,365,430]),
'为了理解这种取舍，我们又检查了几种机制。RoPE-z 对共同标准化平移的响应很小，但这并不等于所有真实浓度同比例变化时也不变。地化版某些主量角度差很小，提示坐标压缩可能影响模型，但不能据此认定已经找到邻域退化的原因。更重要的反例是，随机初始化模型往往比训练模型更平滑，却没有好的岩石邻域。因而，平滑性可以作为一个受控性质来测量，却不适合单独作为“地质语义”的评分。',[G+'REPORT.md',SYN],{detail:true});
add(4,'RoPE 实验改变了我们评价模型的方式','局部更规则，与整体岩石邻域更好，可以分开变化','接下来需要把信息、距离和过程分别评价',
{kind:'tradeoff'},
'到这里，我们看到 RoPE 确实让小幅含量变化对应的空间响应更规则了。但接下来我又检查了一件事：这些样品在空间里，是否更容易和同类岩石靠在一起？结果并没有同步改善。这让我意识到，局部变化更平滑，只回答了空间的一方面。训练损失降低、信息容易读出、邻域组织合理、过程可以预测，可能朝不同方向变化。因此，接下来的工作不是用一个综合分数宣布谁最好，而是为这些问题分别设计可解释的测试。',[G+'REPORT.md',B+'REPORT.md']);

agenda(5,'接下来是统一评价。前面各轮探索已经提供了很多线索，但样品、目标和指标并不总是一致。新评价把传统方法和三个固定模型放到共同任务里，同时让相同的理想过程轨迹进入六种表示，逐层检查它们的能力。');
add(5,'把能力画像改成逐层深入的问题','读取信息、恢复信息、比较距离、预测过程','四层是逐步加深的追问，不是严格相互蕴含的定理',
{kind:'layers'},
'最开始，我把表征评价看成多个并列指标。后来发现，一个简单地球化学向量本身就可能有很强的预测能力，而高分类分数也不保证空间距离合理。所以第二步，我把它组织成逐层递进的体系：先问信息是否容易读出来，再问选定任务需要的信息是否仍能恢复，然后检查距离是否对应指定属性，最后问空间能否描述和预测过程。这四层各有独立任务，并不是上一层通过就必然通过下一层。传统标准化和 PCA 也作为正式对照，与模型表示一起参加评价。',[B+'README.md',B+'REPORT.md',ROOT+'presentation_html/build_presentation.py']);
add(5,'同一份记录，进入六种不同表示','三种传统对照，三个已经训练好的模型','共同原料与共同任务，保留各方法本来的输入变换',
{kind:'baselines'},
'六种表示分成两组。第一组是原值标准化、地化标准化和地化标准化后的 PCA；第二组是 V2、RoPE-z 和 RoPE-地化版。它们读取同一份原始记录，然后执行各自预先定义的处理。原值标准化包含缺测标记，地化标准化加入主量相对组成和微量参考信息，模型则调用训练时对应的配置。这样做既保留方法本身，又让测试问题一致。由于各方法的维数不同，下游读出器和过程算子的参数量也可能不同，不能只比较误差而忽略容量。',[B+'src/representations/baselines.py',B+'src/adapters/checkpoints.py']);
add(5,'统一任务，也要交代数据曾被谁看过','新抽取 12,000 条真实记录；读出器按 70/15/15 划分','这里的测试集，只隔离读出器拟合，没有隔离原模型预训练',
{kind:'split'},
'新评价重新抽取了一万两千条真实记录，再按样品编号固定划分为训练、验证和测试。训练部分用于拟合基线统计量和读出器，验证部分选参数，测试部分报告分数。但这些真实记录此前都参加过三个模型的全量预训练，所以这个划分只隔离了后续读出器的学习，不能当作独立来源泛化。它也不是旧审计那一万两千个编号的直接延续。旧审计主要看岩石类型余弦近邻，新评价还有岩石大类读出和欧氏距离测试，解释结果时要保留这种协议差别。',[B+'README.md',B+'src/data.py'],{detail:true});
add(5,'预测某个指标前，先删去能直接给出答案的字段','先隐藏目标相关输入，再做全部预处理','防止答案通过闭合、比值或其他变换重新进入表示',
tbl(['目标','先删除的模型输入','测试含义'],[['SiO₂ 含量','SiO₂','其他化学观测能否支持恢复'],['镁值 Mg#','MgO、FeO、Fe₂O₃','避免直接用组成字段算答案'],['10 种稀土总量','模型可见的全部稀土字段','检查其余输入提供的推断信息']], [265,365,490]),
'比如想检查模型能不能恢复二氧化硅，如果仍然把二氧化硅送进去，就没有回答我们真正的问题。因此，这里先从原始记录删掉目标对应字段，再执行闭合、标准化和编码。镁值的测试还会删掉镁和相关铁字段；十种稀土总量的测试，会删掉所有模型可见的稀土输入。先删除、后预处理的顺序很重要，否则目标可能通过某种比例或归一化重新进入输入。这里的十种稀土总量是数据库可用十项的完整面板之和，不是完整十四种稀土总量。',[B+'src/data.py',B+'REPORT.md'],{detail:true});
add(5,'信息是否容易读出：使用从简单到复杂的读出器','表示固定，只训练后面负责读取答案的小模型','同样有信息，可能需要不同复杂度才能读取',
{kind:'probes'},
'第一层关注读取信息有多难。我们固定六种表示，再接上线性读出器，以及三档逐渐增大的小型神经网络。如果一个简单线性模型就能读出答案，说明信息在这个坐标里比较容易被使用；如果需要更复杂的模型，说明信息也可能存在，只是组织方式不同。这里给各档相同的学习率搜索预算，并由验证集决定停止时机。不过它仍然是有限训练预算下的实际表现，不是数学上的最优上限。大网络也可能表现更差，因此后面保留完整曲线而不只展示最好的一点。',[B+'configs/benchmark.json',B+'src/probes/evaluate.py']);
add(5,'岩石大类和成因信息更容易被线性读取','三模型岩石大类约 0.66；原值标准化约 0.54','类别读出提升，不等于原生距离或未知来源泛化提升',
{kind:'dualchart',left:{...bars(mn,probe('rock_group'),'线性平衡准确率',{min:0,max:.8,format:'0%',modelColors:true}),title:'岩石大类'},right:{...bars(mn,probe('rock_origin'),'线性平衡准确率',{min:0,max:.6,format:'0%',modelColors:true}),title:'岩石成因类别'}},
'先看简单线性读出器。三个模型的岩石大类平衡准确率都在零点六六左右，高于原值标准化的零点五四。岩石成因类别也有较明显的提升。这说明在当前样品、标签和预算下，模型让这些信息更容易被线性提取。但三个模型的大类分数非常接近，不能凭最后几位小数分出稳健胜负。更重要的是，这不与前面 RoPE 岩石近邻下降矛盾：前面看细粒度标签在原生空间的近邻，这里训练了一个读出器，目标标签也不同。',[B+'outputs/decodability/metrics.csv']);
add(5,'完整读出曲线：增加参数不总是有益','曲线横轴为读出器实际参数量的对数','线性读出强，并不保证更大的网络继续提高',
{kind:'dualchart',left:{...curves('rock_group','balanced_accuracy'),title:'岩石大类'},right:{...curves('rock_origin','balanced_accuracy'),title:'岩石成因类别'}},
'这一页可以快速看趋势，细节留给讨论。横轴是每个读出器真实参数量的对数，最左边通常对应最简单的线性模型，右侧是更大的网络。岩石大类的曲线相对平稳，但成因类别上，一些大网络明显低于线性读出。这可能与目标支持数量、优化预算和任务特征有关，所以不能把曲线当作读出能力的理论上界。由于表示维数不同，各方法覆盖的参数范围也不同，不能把不同横轴区间下的曲线面积强行汇成一个总排名。',[B+'outputs/decodability/metrics.csv',B+'configs/benchmark.json'],{detail:true});
add(5,'化学恢复：SiO₂ 和镁值可读，稀土总量仍困难','目标组成字段已在预处理前删除','V2 的恢复较强；ΣREE10 的线性 R² 都接近零',
{kind:'triplechart',panels:[{...curves('SiO2','R2'),title:'SiO₂ 恢复'},{...curves('Mg_number','R2'),title:'镁值恢复'},{...curves('SigmaREE10','R2'),title:'10 种稀土总量'}]},
'化学目标则呈现另一种差异。删除二氧化硅输入后，V2 的线性恢复 R² 约为零点九五，两个 RoPE 版本分别约为零点八八和零点八五。镁值也能够从其余观测中读出一部分信息，但原值基线的简单读出表现并不稳定。右图的稀土总量更值得注意：各表示的线性 R² 都接近零，部分复杂读出器也没有改善。因此当前结果不支持可靠推断稀土总量。这里 R² 的零附近意味着与该统计参照相比没有实质解释力，负值也不能被隐藏。',[B+'outputs/decodability/metrics.csv',B+'REPORT.md'],{extra:'ΣREE10 完整标签的测试支持约 265 个样品。图表保留不同任务各自的纵轴范围，不能把三张图的视觉起伏直接比较。'});
add(5,'随机隐藏 20% 观测，检查能恢复多少','六种表示使用同一份随机遮盖；仅评价被隐藏的有效字段','这是选定恢复任务下的信息检验，不是全部信息的证明',
{kind:'dualchart',left:{...bars(mn,models.map(m=>data.recovery[m].major),'各主量字段 R² 的中位数',{min:0,max:.8,format:'0.00',modelColors:true}),title:'主量恢复'},right:{...bars(mn,models.map(m=>data.recovery[m].trace),'各微量字段 R² 的中位数',{min:-.2,max:.5,format:'0.00',modelColors:true}),title:'微量恢复'}},
'第二层换成共享随机遮盖。每条记录随机隐藏百分之二十的已观测字段，六种表示使用完全相同的一份遮盖，再用线性方法恢复这些原值。只评价原本有效、这次被隐藏的字段，并先按字段计算 R²，再取字段中位数。V2 在主量和微量组上分别约为零点六五和零点三五，是这一轮较强的结果。但这个任务只能检查选定输入的恢复能力，不能证明所有信息都充分保留。年龄和同位素从来没有进入这些编码器，预测它们应称为外部目标预测，不能混作输入重建。',[B+'outputs/sufficiency/masked_recovery.csv',B+'README.md']);
add(5,'来源和测项组合，也同样容易被读取','地质信号与数据采集方式可能同时进入表示','目前不能把所有岩石读出提升都解释为地质信息',
{kind:'chart',chart:'bar',categories:mn,series:[{name:'数据来源',values:models.map(m=>Number(data.nuisance.find(r=>r.representation===m&&r.target==='data_source').balanced_accuracy))},{name:'缺测模式',values:models.map(m=>Number(data.nuisance.find(r=>r.representation===m&&r.target==='missingness_cluster').balanced_accuracy))}],min:0,max:1,format:'0%',yTitle:'线性读出平衡准确率',legend:true},
'如果表示很容易告诉我们样品来自哪个数据库或哪类测项组合，那么部分分类提升也可能与采集方式有关。这里三个模型的来源读出分数都不低，缺测模式也非常容易读取。我们并不是要求表示完全丢掉来源信息，而是提醒：当前还无法把岩石分类的全部增量解释为独立地质知识。原值和地化基线本身显式包含缺测标记，因此它们的缺测高分也不奇怪。文献读出另有限定，只覆盖训练中有足够样本的最多六十四篇引用，不能把它当成全部文献的识别能力。',[B+'outputs/sufficiency/nuisance.csv',B+'REPORT.md']);
add(5,'距离检验：属性更近的样品，坐标也更近吗？','围绕一个锚点，比较“属性近”和“属性远”的两个样品','这里使用未遮盖化学输入，回答空间组织问题',
{kind:'triplet'},
'第三层直接检查坐标距离，不再额外训练一个分类器。以一个样品为锚点，再选一个指定属性更相近的样品和一个更远的样品，看看表示空间中的距离次序是否符合预期。连续属性会尽量匹配岩石大类和测项数量，以减少一些明显差异。这里使用未遮盖的化学输入，因为问题是已有信息在空间中怎样组织；它与前面的隐藏目标恢复是不同测试。模型距离在原生空间中计算，只做统一尺度处理，二维图仅用于帮助理解。',[B+'src/semantic/evaluate.py',B+'README.md']);
add(5,'类别容易读出，原生距离却未必更合理','选取 SiO₂、稀土总量和外部 Eu 异常三个目标','传统地化坐标在某些属性上仍是更强的对照',
{kind:'chart',chart:'bar',categories:['SiO₂','10 种稀土总量','Eu 异常'],series:models.map((m,i)=>({name:mn[i],values:['SiO2','SigmaREE10','Eu_anomaly'].map(t=>Number(data.semantic.find(r=>r.representation===m&&r.target===t).triplet_accuracy))})),min:0,max:1,format:'0%',yTitle:'距离次序正确比例（越高越好）',legend:true},
'这三个例子说明，读出信息与组织距离确实是不同能力。对于二氧化硅，原值标准化的距离次序正确比例约为零点九一，V2 约为零点八六，地化 RoPE 约为零点八零。Eu 异常上，传统地化标准化和它的 PCA 版本约为零点七四，高于三个模型。Eu 异常由外部的钐、铕、钆字段定义，这些字段不在模型的三十四项输入里。结论是，当前原生欧氏距离没有表现出普遍更忠实的化学语义；但这也不能反推模型完全不含这些信息。',[B+'outputs/semantic_geometry/metrics.csv',B+'REPORT.md']);
add(5,'完整几何检查还包括邻域指标连续性','表中为三点距离次序正确比例，越高越好；另检查邻域连续性','在邻居之间变化更连续，是另一种可检查的空间性质',
{kind:'semanticmatrix'},
'除了刚才的三点距离比较，我们还在测试样品中构建二十近邻图，检查相邻样品的地质指标变化是否连续，并用随机置换标签作为参照。这里把完整的九类属性放在一张表中，让大家看到表现是任务相关的。主量、比值、稀土和岩石标签，并不会总是给出同一个模型次序。这个细节页可以快速通过，重点是保留完整证据，避免只挑一个有利目标。匹配失败时的回退次数和有效样本数量也保存在协议文件中。',[B+'outputs/semantic_geometry/metrics.csv',B+'src/semantic/evaluate.py'],{detail:true});
add(5,'理想过程提供已知答案的空间实验','静态样品不够，需要知道它们如何一步步变化','六种表示接收同一条已保存的物理轨迹',
{kind:'bank'},
'真实样品提供了丰富信息，但往往不知道两个样品之间准确经历了什么过程。因此下一步，我构造一些具有已知规则的理想过程，例如混合、分离结晶、部分熔融和元素增减，再把每一步物理状态送入六种表示。这相当于给空间出一套有标准输入变化的题目。本轮每类单过程有两千条，合成和半合成各半，另外有八千条复合轨迹。它们共享初值、参数和轨迹记录，不是为每个模型单独生成一套更有利的样品。',[B+'README.md',B+'src/process_bank/episode.py']);
add(5,'过程初值：人工生成与真实样品各占一半','两条生成路径汇合到同一个共享轨迹库','理想构造用于受控检验，不是完整自然岩浆模拟',
{kind:'initials'},
'初值有两条路径。合成路径从矿物质量比例出发，用化学计量得到主量氧化物，再结合训练数据拟合的微量先验和参数化稀土曲线。半合成路径则选择主量面板完整、数值合法的真实样品，按规则处理后作为起点。这两组分开统计，因为人工先验和真实初值各有局限。完整主量条件只覆盖真实数据的一个子集。无论哪条路径，这一轮都不是经过全面相平衡校准的自然岩浆模型，主要目的还是让不同表示面对同样、可复现的输入变化。',[B+'src/process_bank/rock_generator.py',B+'src/process_bank/trace_generator.py',B+'src/process_bank/episode.py'],{detail:true});
add(5,'混合：两个端元按比例汇合','C(t) = (1−t) Cₐ + t Cᵦ','在线性原值坐标里，这条关系本来就是直线',
{kind:'process',process:'mixing'},
'第一种过程最容易理解：固定两个端元，只改变混合比例。某个元素在混合物中的浓度，就是两个端元浓度的加权平均。左边表示两份物质汇合，右边表示这个过程在原始线性坐标中形成的直线。这个例子特别重要，因为它给了一个天然很强的基线。如果模型把原本简单的关系弯曲了，我们就不能因为模型轨迹看起来连续，就说它更懂混合。后面的结果会专门检查这种扭曲。这里只是理想浓度混合，并不自动覆盖反应、结晶或体积变化等复杂情况。',[B+'src/process_bank/operators/mixing.py',B+'REPORT.md']);
add(5,'分离结晶：矿物移出，剩余熔体组成改变','主量受矿物移除预算约束；微量服从理想 Rayleigh 关系','分开的两条规则共同构成本轮试验轨迹',
{kind:'process',process:'fractionation'},
'第二种过程是分离结晶。直观上，部分矿物从初始熔体里分离出去，剩余熔体的组成就会改变。图中因此需要画出移出的矿物和剩余熔体两条分支。本轮主量部分采用受氧化物预算约束的矿物移除，微量部分则使用理想 Rayleigh 公式，随剩余熔体比例和分配系数变化。它们共同给出可重复的轨迹，但分配系数来自合成先验，没有把矿物比例与相平衡完全耦合起来。因此这里测量的是这一套规定模型下的表示表现，不是已经验证某个自然岩浆房的演化。',[B+'src/process_bank/operators/fractionation.py',B+'REPORT.md']);
add(5,'部分熔融：改变熔融程度，观察微量响应','Cₗ = C₀ / [D + F(1−D)]','本轮主量保持不变；熔体产物不能直接当作源岩的连续起点',
{kind:'process',process:'melting'},
'第三种过程是批次部分熔融。随着熔融比例变化，元素进入熔体的浓度受分配系数控制。这里先画出源岩产生熔体和残余体的概念，再明确我们实际计算的是哪一部分：本轮主要改变微量元素，主量保持不变。还有一个影响复合过程设计的细节，熔融比例从零点零一开始时，第一份熔体产物并不等于原始源岩。所以不能把它硬接到上一段过程末尾，假装边界连续。也正因此，本轮复合过程没有纳入这条批次熔融路径。',[B+'src/process_bank/operators/partial_melting.py',B+'REPORT.md']);
add(5,'理想蚀变：只让部分元素按规定增减','Cᵢ(t) = Cᵢ(0) · exp(t aᵢ)','没有映射到某一种具名自然蚀变，也没有事后闭合',
{kind:'process',process:'alteration'},
'第四种过程模拟稀疏的元素增减。约百分之三十的字段按规定指数规律变化，其余字段保持不变，稀土元素还可以共享一部分扰动。这样可以检验一种明确的乘性浓度规律，在不同坐标中是否容易表达。这里不把它命名为某一种自然热液蚀变，因为没有加入足够的流体、反应和质量平衡约束。浓度使用固定参考质量，也不做事后闭合。因此，这里的“蚀变”是受控数学过程的简称，不能直接等同于自然岩石在开放体系中的完整演化。',[B+'src/process_bank/operators/alteration.py',B+'REPORT.md']);
add(5,'过程轨迹需要看方向、弯曲和折返','四个指标对应四种不同的几何问题','停在原地不能被奖励为“完美平滑”',
{kind:'metrics'},
'得到轨迹后，不能只凭肉眼看它顺不顺。我们分别问，相邻两步方向是否一致，实际路程比起端点直线距离多走了多少，一小段轨迹是否主要沿一个方向，以及相隔很远的过程状态是否又碰到一起。图上用四个小例子解释这些问题。它们是不同性质，不能互相替代。尤其是几乎不动的向量，看起来可能非常稳定，却没有反映输入过程；这类零位移被记为不可定义，而不会得到完美平滑分数。防折返指标也只是启发式诊断，不是拓扑证明。',[B+'src/operators/metrics.py'],{detail:true});
add(5,'一步预测：当前坐标和过程参数共同决定下一步','用同一类线性算子拟合：dz/dt = A z + B θ + b','过程参数已知；这里不检验模型能否自行辨认自然过程',
{kind:'operator'},
'几何之外，我们还希望问，这个空间里的过程是否容易预测。做法是把当前向量和已知过程参数一起送给一个线性算子，预测下一步，再与真实编码结果比较。训练、验证和测试按初始状态分组，整条轨迹不会拆开跑到不同集合里。误差除以各表示训练样品的整体尺度，便于比较。但七百六十八维空间对应的线性算子，参数量也明显更多。因此，如果某个模型误差低，只能说明在当前算子和预算下预测较好，不能立刻说这个空间的规律更简单。',[B+'src/operators/linear.py',B+'README.md'],{extra:'三个模型的非混合算子含 701,184 个系数，混合算子含 1,291,008 个系数。GeoNorm 对应为 15,624 和 20,808。'});
add(5,'连续多步预测：误差会沿路径继续传递','前一段的预测终点，成为下一段的输入','过程边界处不重新给出真实中间答案',
{kind:'composite'},
'一步预测容易掩盖累积误差，所以我们还把两到三段过程接起来。前段预测到哪里，后段就从哪里继续，不在边界处偷偷换回真实中间状态。图中上方是共享的真实过程，下方是模型连续推进的路径，最终比较终点误差。混合任务所需的阶段起点，也从上一段预测中取得，避免把真实中间化学信息重新作为条件送进去。这样更接近检验一个空间能否支持连续过程计算，而不是每一步都在正确答案旁边重新出发。',[B+'src/operators/evaluate.py',B+'src/process_bank/composite.py']);
add(5,'交换过程顺序，结果是否仍然一样？','同一个起点和参数，比较先混合后分异与先分异后混合','只在两种顺序都合法的子集中评价',
{kind:'order'},
'另一个更接近过程语义的问题是顺序。先混合再分异，与先分异再混合，通常不必得到相同结果。我们用相同初值和参数生成两条路径，再检查物理结果差异的大小排序，是否在表示空间里仍被保留。但并不是所有反序都合法，有些次序会违反预算或浓度约束，因此必须报告覆盖率，不能悄悄丢掉不利样本。测试中合法反序覆盖约百分之五十三到五十九。模型对顺序效应的排序有中等保留，但目前并没有比原值基线更强的普遍证据。',[B+'outputs/composite/order_coverage.csv',B+'outputs/composite/noncommutativity.csv',B+'REPORT.md'],{detail:true});
add(5,'看同一条过程，在六种表示中怎样展开','依次播放混合、分离结晶、部分熔融与理想蚀变','投影只用于观看；定量评价使用原生空间',
{kind:'video',path:ROOT+'presentation_v2_evaluation/assets/PartialMelting_median_frame016.png',video:ROOT+'presentation_v2_evaluation/output/four_processes.mp4'},
'下面用一段短视频把过程和空间联系起来。四段分别对应混合、分离结晶、部分熔融和理想蚀变，同一物理状态同时进入六种表示。观看时，主要留意轨迹是否弯曲、是否出现速度变化，以及不同过程是否表现不同，不需要用肉眼给模型排名。每种表示使用固定的三维 PCA 只为显示，投影可能隐藏其他方向上的变化。真正的指标仍在原生表示空间中计算。视频结束后，我们再回到数值结果，检查刚才看到的现象是否得到定量支持。',[ROOT+'presentation_v2_evaluation/output/four_processes.mp4',B+'outputs/animations/selection.json'],{extra:'视频中的英文缩写对应本章已解释的六种表示。静态 PDF 保留后备帧；独立 MP4 同时放入交付包。'});
add(5,'单过程：RoPE-地化在模型内较好，但基线仍强','测试轨迹的一步归一化误差中位数；越低越好','过程收益依赖具体坐标和定律',
{kind:'operatortable'},
'这张表每一列是一类过程，数值越低表示一步预测误差越小。RoPE-地化版在四列中都低于另外两个训练模型，这是值得继续研究的方向。但把传统基线一起保留后，结论就更具体了：原值标准化的线性混合误差几乎为零，结晶分离也已经很强；地化标准化在理想蚀变和部分熔融上仍然优于三个模型。因此不能说某个模型统一掌握了地质过程。还要记住，这里展示的是中位数排序，并非三个训练模型之间都做了直接差值显著性检验。',[B+'outputs/process/operator_metrics.csv',B+'REPORT.md']);
add(5,'原本线性的混合，被三个模型不同程度地弯曲','合成混合轨迹：相对原值标准化的路径简单度差','RoPE-地化减少了扭曲，但没有保持原始线性关系',
bars(['V2','RoPE-z','RoPE-地化'],[-.4992,-.5318,-.2977],'相对原值标准化的配对中位差',{min:-.6,max:0,format:'0.00',yTitle:'负值表示模型使路径更弯曲'}),
'再回到最容易验证的混合。原值线性坐标本来给出直线，而三个模型的路径简单度都下降了，配对区间也都低于零。地化 RoPE 的下降较小，说明在这一项上减少了扭曲，但它仍然没有保留原始的线性混合关系。这个结果很好地说明了传统基线的重要性：如果只比较三个复杂模型，我们可能会把“较少弯曲”说成“学会混合规律”；加入原值对照后，更准确的说法就变成了“比另外两个模型少损失了一部分原有结构”。',[B+'outputs/tables/paired_statistics.csv',B+'REPORT.md']);
add(5,'复合过程没有统一优胜者，细微差异仍需保留判断','连续预测终点误差中位数；两类复合过程分开','35 项误差比较扩至 8,000 条后，仍未达到预设区间精度',
{kind:'dualchart',left:{...bars(mn,models.map(m=>data.composite[m].heterogeneous),'归一化终点误差',{min:0,max:1.3,format:'0.00',modelColors:true}),title:'不同过程组合'},right:{...bars(mn,models.map(m=>data.composite[m]['same-process']),'归一化终点误差',{min:0,max:.8,format:'0.00',modelColors:true}),title:'同类过程重复'}},
'连续多步预测中，地化 RoPE 的中位误差仍是三个训练模型中较低的，但原值基线在这里的概览中位数更低。不同过程组合和同类过程重复的次序也不完全一样。统计上，我们按同一轨迹编号做配对，并对重复自然初值进行聚类重采样，最多扩到八千条复合过程。即便如此，仍有三十五项误差比较没有达到预设的区间半宽目标。因此，这一轮足以看到主要取舍，却不适合围绕很小的名次差异作强结论。到这里，四层评价给出了能力分化，而不是一个总冠军。',[B+'outputs/composite/metrics.csv',B+'outputs/tables/precision_status.json',B+'outputs/tables/paired_statistics.csv'],{extra:'95% 区间目标半宽为 0.02，当前最大半宽约 0.1454。504 项探索性配对比较不是独立发现数，也没有用作多重检验后的显著发现计数。'});

agenda(6,'最后把模型设计、旧空间审计和新过程评价放在一起。我们现在可以说清楚一些能力，也能说清楚哪些愿景还没有得到验证。下一步应当优先补最能区分机制和验证泛化的实验。');
add(6,'三个模型各有收益，也各有代价','把具体能力并列，不计算人为加权总分','当前证据支持的是能力分化',
tbl(['模型','目前较有支持的能力','仍然存在的代价'],[['V2','旧岩石近邻较好；主量／微量恢复较强','距离和过程预测未普遍领先'],['RoPE-z','部分小扰动更规则；成因线性读出较高','旧岩石近邻与部分化学恢复下降'],['RoPE-地化','部分过程预测误差较低；局部更规则','全局邻域较弱；未普遍超过传统基线']], [200,460,460]),
'把全部结果放在一起，V2 的优势主要在旧岩石近邻和本轮化学恢复。RoPE-z 在部分小尺度响应及成因信息的线性读取上有特点，但并没有改善所有空间性质。地化 RoPE 在本轮若干过程预测中更有希望，同时付出了背景和邻域组织方面的代价。三个模型也都受到来源、缺测模式和训练标签的影响。因此我暂时不把这些能力压成一个人为加权总分，而是根据以后真正要做的任务，选择相应证据，并保留传统基线参与比较。',[SYN,G+'REPORT.md',B+'REPORT.md']);
add(6,'回到最初的问题：地质关系能否成为可运算的坐标？','目前已经看到局部线索，尚未形成通用关系体系','研究愿景保留，论证需要逐项推进',
{kind:'return'},
'回到开头的岩石类比，我们现在可以更准确地回答。模型已经能把整份样品的背景组织到元素表示里，也出现了部分局部一致和近似可加的响应。但标签关系与样品空间还没有自然对齐，简单的物理混合仍可能被弯曲，过程优势也取决于具体定律。因此，距离一个通用、可迁移的地质向量算术体系还有明显距离。这并不意味着最初的愿景没有价值，而是它需要被拆成可验证的小问题。我们现在比一开始更清楚，下一步应该验证哪一种关系。',[SYN,B+'REPORT.md']);
add(6,'当前结论适用于这些边界之内','预训练暴露、组合改动、理想化过程、统计不确定性','先交代证据能覆盖什么，再讨论应用',
{kind:'boundaries'},
'最后集中交代四个边界。第一，真实样品和岩石标签参加过预训练，现有下游测试不能证明未知地区泛化。第二，每种设计只有当前这一轮训练，地化版同时改了坐标和遮盖设置，不能分离单个因素。第三，过程库采用理想定律和有限先验，半合成也只覆盖面板完整的子集，不能代表全部自然过程。第四，部分复合误差仍有较宽区间。把这些边界说清楚后，现有结果仍然有价值：它为后续实验提供了具体、可以被否证的机制假设。',[SYN,G+'REPORT.md',B+'REPORT.md']);
add(6,'先补齐坐标与遮盖的交叉实验','保持 RoPE 架构，分别改变一个因素','已有两格，补齐另外两格后再分析机制',
tbl(['数值坐标','单个数值遮盖','约 15% 数值遮盖'],[['原 z 坐标','已完成：RoPE-z','待补：只增加遮盖量'],['地化坐标','待补：只改变坐标','已完成：RoPE-地化']], [260,430,430]),
'最直接的下一步，是补齐这个二乘二表格。当前已经有原 z 坐标配单值遮盖，以及地化坐标配百分之十五遮盖，缺少另外两个组合。保持 RoPE 架构和比较预算，分别补原 z 的多值遮盖，以及地化坐标的单值遮盖，才能更清楚地区分两类改变的作用。即便补齐，也需要重复训练种子，并检查各数值族尺度和有效输入支持。图中的待补格子是研究计划，不是已经验证有效的修复方案。',[SYN,G+'REPORT.md']);
add(6,'下一步用独立数据和真实过程检验这些线索','先隔离来源再预训练；用已知过程约束空间','目标仍是：形成有用、可信、可检验的地球化学坐标',
{kind:'next'},
'更重要的下一步，是先按文献、地区或岩套隔离数据，再只用训练部分预训练，这样才能第一次真正检验未见来源的能力。过程方面，需要引入自然岩套或经过校准的岩石学正演，并尽量匹配维数和算子参数预算，再判断模型有没有带来实际收益。对我来说，这一阶段最大的进展，是把“模型看起来学到东西”细化成一组可以分别回答的问题。我们已经知道一些信息变得更好读，也知道距离和过程并不会自动变好。后面的工作，就沿着这些明确的缺口继续推进。谢谢大家，欢迎讨论。',[SYN,B+'REPORT.md']);

// Detailed material from the former appendices stays with its relevant chapter.
slides.find(s=>s.visual.kind==='initials').extra='如果展开初值生成，主量从四类岩石的矿物比例中心抽样，只对原先为正的组分分配质量，零组分保持为零，再通过石英、长石、辉石、橄榄石和副矿物的固定组成换算为氧化物含量。微量先验则在训练数据的对数浓度上做六维 PCA 抽样，稀土另用参数化曲线。分配系数按相容、中性和不相容组生成；每条轨迹保存随机种子与参数，便于追溯。';
slides.find(s=>s.visual.kind==='order').extra='反序覆盖的具体分母也要保留：合成测试中，两种顺序均合法的有 170 / 322 条；半合成中有 178 / 304 条。它们是不同的测试子集，不能拿合法子集的表现代表所有过程组合。';
slides.find(s=>s.visual.kind==='probes').extra='每档读出器都比较两个候选学习率。分类按验证集交叉熵选择，连续目标按验证集均方误差选择；所有比较都保留相同的搜索规则与实际参数量。';

// A single source controls slide numbering, timing, notes and evidence exports.
const shortSubtitles={
  3:'数据表示',4:'传统坐标',5:'黄铁矿对照',6:'空间几何',7:'词向量类比',8:'岩石类比',9:'早期评价',10:'工作脉络',
  12:'全岩样品',13:'可变测项',14:'信息单元',15:'V2 架构',16:'注意力',17:'遮盖训练',18:'样品向量',19:'数值坐标',20:'训练配置',
  22:'实验全貌',23:'上下文信息',24:'全化学对照',25:'元素语义',26:'局部扰动',27:'响应叠加',28:'维度影响',29:'投影复验',30:'邻域结构',31:'缺测影响',32:'标签对齐',
  34:'改动动机',35:'注意力拆解',36:'旋转编码',37:'三模型对照',38:'训练结果',39:'岩石邻域',40:'局部响应',41:'背景读出',42:'机制线索',43:'阶段认识',
  45:'分层评价',46:'六种表示',47:'数据划分',48:'防止泄漏',49:'信息读出',50:'标签读出',51:'读出曲线',52:'化学恢复',53:'遮盖恢复',54:'来源信息',55:'距离三点检验',56:'几何结果',57:'邻域连续性',58:'过程实验',59:'过程初值',60:'理想混合',61:'分离结晶',62:'部分熔融',63:'理想蚀变',64:'轨迹指标',65:'单步预测',66:'连续预测',67:'顺序效应',68:'过程动画',69:'单过程结果',70:'混合弯曲',71:'复合过程',
  73:'收益与代价',74:'研究愿景',75:'证据边界',76:'消融实验',77:'下一步'
};
const chapterSeconds=[0,420,540,600,600,1140,300];
for(let c=1;c<=6;c++){
 const group=slides.filter(s=>s.ch===c);
 const weight=s=>s.visual.kind==='agenda'?0.22:s.detail?.55:s.visual.kind==='video'?1.3:1;
 const sum=group.reduce((a,s)=>a+weight(s),0);
 let allocated=0;
 group.forEach((s,i)=>{s.seconds=i===group.length-1?chapterSeconds[c]-allocated:Math.round(chapterSeconds[c]*weight(s)/sum);allocated+=s.seconds;});
}
slides[0].seconds=30;
slides.forEach((s,i)=>{
 s.page=i+1;
 if(s.visual.kind!=='cover'&&s.visual.kind!=='agenda'){
  s.sub=shortSubtitles[s.page];
  if(!s.sub||Array.from(s.sub).length>8)throw new Error('Invalid short subtitle on page '+s.page);
 }
 s.evidence=s.evidence.map(e=>e.replace('G2_volcanic_plutonic_analogy','G2_volcanic_plutonic'));
 s.notes=s.speech+(s.extra?'\n\n追问时展开：'+s.extra:'')+'\n\n证据索引：'+s.evidence.join('；');
});
if(slides.length<65||slides.length>78)throw new Error('Unexpected slide count '+slides.length);
