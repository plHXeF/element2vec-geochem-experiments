import fs from 'node:fs/promises';
import path from 'node:path';
import {FileBlob,PresentationFile} from '@@ARTIFACT_TOOL@@';
import {slides,chapters,data} from './slides.mjs';

const DIR=path.dirname(new URL(import.meta.url).pathname),ROOT='@@WORKSPACE@@';
const SOURCE=path.join(ROOT,'presentation_v2_evaluation/output/Geochem_评价体系汇报_20260917.pptx');
const OUT=path.resolve(DIR,'../output');
const FONT='Hiragino Sans GB';
const C={blue:'#073B82',ink:'#162D46',muted:'#5C6C7D',red:'#C4373D',pale:'#EEF3F9',line:'#CCD8E5',teal:'#168E91',gold:'#C98C28',violet:'#8053AB',gray:'#7A8898',white:'#FFFFFF'};
const modelColors=[C.gray,'#3D8A6E','#87AC86',C.blue,'#DA8A31',C.violet];
const pres=await PresentationFile.importPptx(await FileBlob.load(SOURCE));
for(const s of [...pres.slides.items])s.delete();
const bounds=[];let pageNo=0;
function shape(s,x,y,w,h,fill='none',g='rect',stroke='none',sw=0){return s.shapes.add({geometry:g,position:{left:x,top:y,width:w,height:h},fill,line:{fill:stroke,width:sw}});}
function txt(s,text,x,y,w,h,size=24,color=C.ink,bold=false,align='left'){
 const a=shape(s,x,y,w,h,'none','textbox');a.text=String(text);
 a.text.style={typeface:FONT,fontSize:size,color,bold,autoFit:'none',alignment:align,verticalAlignment:'middle',insets:{left:0,right:0,top:0,bottom:0}};
 bounds.push({page:pageNo,text:String(text),x,y,w,h,size});return a;
}
function line(s,x1,y1,x2,y2,color=C.line,width=2,dash=false){
 return s.shapes.add({geometry:'line',position:{left:Math.min(x1,x2),top:Math.min(y1,y2),width:Math.abs(x2-x1)||.1,height:Math.abs(y2-y1)||.1,verticalFlip:(y2-y1)*(x2-x1)<0},fill:'none',line:{fill:color,width,style:dash?'dashed':'solid'}});
}
function pathLine(s,points,color=C.blue,width=3,dash=false){
 const xs=points.map(p=>p[0]),ys=points.map(p=>p[1]),x=Math.min(...xs),y=Math.min(...ys),w=Math.max(...xs)-x||1,h=Math.max(...ys)-y||1;
 return s.shapes.add({geometry:'custom',position:{left:x,top:y,width:w,height:h},fill:'none',line:{fill:color,width,style:dash?'dashed':'solid'},customPaths:[{width:w,height:h,commands:points.map((p,i)=>({[i?'lineTo':'moveTo']:{x:p[0]-x,y:p[1]-y}}))}]});
}
function node(s,label,x,y,w=190,h=66,color=C.blue,fill=C.pale,size=23){
 const a=shape(s,x,y,w,h,fill,'roundRect',color,1.5);a.text=label;a.text.style={typeface:FONT,fontSize:size,color,bold:true,autoFit:'none',alignment:'center',verticalAlignment:'middle',insets:{left:10,right:10,top:4,bottom:4}};bounds.push({page:pageNo,text:label,x,y,w,h,size});return a;
}
function connect(s,a,b,from='right',to='left',color=C.blue,kind='elbow',dash=false){return s.shapes.connect(a,b,{fromSide:from,toSide:to,kind,line:{fill:color,width:2.2,style:dash?'dashed':'solid'},tail:{type:'triangle',width:'sm',length:'sm'}});}
function dot(s,x,y,color=C.blue,r=7){return shape(s,x-r,y-r,2*r,2*r,color,'ellipse');}
function arrow(s,x1,y1,x2,y2,color=C.blue,dash=false){const a=shape(s,x1,y1,1,1,'none','ellipse'),b=shape(s,x2,y2,1,1,'none','ellipse');return connect(s,a,b,'right','left',color,'straight',dash);}
function nn(s,x,y,w=150,h=100,color=C.blue){
 const layers=[3,4,3],nodes=[];for(let i=0;i<3;i++){nodes[i]=[];for(let j=0;j<layers[i];j++)nodes[i].push([x+i*w/2,y+(j+1)*h/(layers[i]+1)]);}
 for(let i=0;i<2;i++)for(const a of nodes[i])for(const b of nodes[i+1])line(s,...a,...b,C.line,1.3);
 for(const l of nodes)for(const p of l)shape(s,p[0]-6,p[1]-6,12,12,C.white,'ellipse',color,2);
}
function rock(s,x,y,scale=1,color=C.gray){
 const pts=[[0,24],[18,0],[65,7],[86,40],[57,69],[13,60],[0,24]].map(([a,b])=>[x+a*scale,y+b*scale]);
 const r=pathLine(s,pts,color,2);r.fill=C.pale;
 for(const [a,b] of [[20,24],[45,36],[28,47],[62,20]])shape(s,x+a*scale,y+b*scale,7*scale,5*scale,color,'diamond');
 return r;
}
function formula(s,label,x=150,y=485,w=980){txt(s,label,x,y,w,58,30,C.blue,true,'center');}
function chart(s,v,x=65,y=182,w=1150,h=392){
 if(v.title)txt(s,v.title,x,y,w,36,23,C.ink,true);
 const cy=v.title?y+42:y,hh=v.title?h-42:h;
 const threeModels=JSON.stringify(v.categories)===JSON.stringify(['V2','RoPE-z','RoPE-地化'])&&v.series.length===1;
 const series=v.series.map((a,i)=>({...a,values:a.values.map(n=>Number(Number(n).toPrecision(12))),...(a.xValues?{xValues:a.xValues.map(n=>Number(Number(n).toPrecision(12)))}:{}),valuesFormatCode:v.format||'0.00',fill:v.modelColors?undefined:(v.series.length===6?modelColors[i]:[C.blue,C.teal,C.gold,C.violet,C.gray,C.red][i]),
 line:{fill:v.series.length===6?modelColors[i]:[C.blue,C.teal,C.gold,C.violet,C.gray,C.red][i],width:2.8},
 ...(v.modelColors||threeModels?{points:a.values.map((_,j)=>({idx:j,fill:modelColors[j+(threeModels?3:0)]}))}:{}),
 marker:{symbol:'circle',size:6}}));
 const ax={typeface:FONT,fontSize:v.compact?16:18,fill:C.muted};
 const c=s.charts.add(v.chart||'bar',{position:{left:x,top:cy,width:w,height:hh},categories:v.categories||[],series,
 barOptions:{direction:'column',grouping:'clustered',gapWidth:70},scatterOptions:{style:'lineWithMarkers'},lineOptions:{smooth:false},
 hasLegend:!!v.legend,legend:{position:'bottom',overlay:false,textStyle:{typeface:FONT,fontSize:v.compact?15:18,fill:C.ink}},
 xAxis:{visible:true,tickLabelPosition:'low',title:v.xTitle?{text:v.xTitle,textStyle:{...ax,fontSize:17}}:undefined,textStyle:ax,line:{fill:C.line,width:1},majorGridlines:null},
 yAxis:{visible:true,title:v.yTitle?{text:v.yTitle,textStyle:{...ax,fontSize:17}}:undefined,min:v.min,max:v.max,numberFormatCode:v.format||'0.00',textStyle:ax,majorGridlines:{fill:'#E1E7ED',width:1},line:{fill:'none',width:0}},
 dataLabels:{showValue:(!v.legend&&(v.chart||'bar')==='bar'),position:'outEnd',textStyle:{typeface:FONT,fontSize:19,fill:C.ink}},
 chartFill:C.white,plotAreaFill:C.white,chartLine:{fill:'none',width:0},plotAreaLine:{fill:'none',width:0}});
 return c;
}
function table(s,v,x=65,y=205,w=1150,h=325,size=23){
 const vals=[v.headers,...v.rows].map(r=>r.map(String));
 const tb=s.tables.add({rows:vals.length,columns:vals[0].length,left:x,top:y,width:w,height:h,values:vals,columnWidths:v.widths});
 tb.borders.assign({fill:C.line,width:1,style:'solid'});
 tb.cells.block({row:0,column:0,rowCount:vals.length,columnCount:vals[0].length}).assign({textStyle:{typeface:FONT,fontSize:size,color:C.ink},margins:{left:14,right:14,top:size<=20?3:9,bottom:size<=20?3:9},anchor:'center'});
 for(let r=0;r<vals.length;r++)for(let c=0;c<vals[0].length;c++){
  const cell=tb.getCell(r,c);cell.fill=r===0?C.blue:(r%2===0?C.pale:C.white);cell.text.style={typeface:FONT,fontSize:r===0?size:size,color:r===0?C.white:C.ink,bold:r===0,autoFit:'none',verticalAlignment:'middle'};
 }
 return tb;
}
function facts(s,v,x=75,y=210,w=1125,h=345){
 const n=v.items.length,ww=w/n;
 v.items.forEach((r,i)=>{const xx=x+i*ww;txt(s,r[0],xx,y,ww-25,52,24,C.muted,true);txt(s,r[1],xx,y+88,ww-25,86,ww<300?36:51,C.blue,true);txt(s,r[2],xx,y+211,ww-28,95,21,C.muted);if(i)line(s,xx-20,y+15,xx-20,y+290,C.line,1);});
 if(v.foot)txt(s,v.foot,x,y+h-10,w,52,18,C.muted);
}
function base(s,spec){
 s.background.fill=C.white;txt(s,`${String(spec.ch).padStart(2,'0')}  ${chapters[spec.ch-1]}`,64,21,760,30,20,C.blue,true);
 txt(s,spec.sub,895,21,320,30,20,C.muted,true,'right');
 txt(s,spec.title,64,66,1150,60,spec.title.length>31?32:36,C.ink,true);
 line(s,65,593,1215,593,C.line,1);
 txt(s,spec.take,65,610,1150,50,spec.take.length>48?23:25,C.blue,true);
 txt(s,`${String(spec.page).padStart(2,'0')} / ${slides.length}`,1112,684,103,20,14,C.muted,false,'right');
 if(spec.detail)txt(s,'细节 · 可快速带过',65,681,290,22,14,C.muted);
}
async function image(s,p,x,y,w,h){const ext=path.extname(p);return s.images.add({blob:await fs.readFile(p),contentType:ext==='.svg'?'image/svg+xml':'image/png',alt:p,fit:'contain',position:{left:x,top:y,width:w,height:h}});}

function diagram(s,v){
 const kind=v.kind;
 if(kind==='representation'){
  txt(s,'一份岩石的观测',75,195,480,40,26,C.blue,true);table(s,{headers:['测项','数值（示例）'],rows:[['SiO₂','50 wt%'],['MgO','8 wt%'],['Rb','40 ppm']],widths:[240,230]},75,250,470,240,25);
  const n=node(s,'同一份信息',603,322,165,70);const a=node(s,'原始含量',875,217,260,60),b=node(s,'对数／标准化',875,323,260,60,C.teal),c=node(s,'模型坐标',875,429,260,60,C.violet);connect(s,n,a);connect(s,n,b);connect(s,n,c);txt(s,'不同表示可能改变样品间的距离',615,525,540,30,22,C.muted);return;
 }
 if(kind==='geometry'){
  for(const [x,y] of [[200,330],[255,285],[310,350],[795,310],[850,260],[910,330]])dot(s,x,y,x<500?C.blue:C.teal,10);
  arrow(s,275,465,540,410,C.gold);txt(s,'相近样品',143,392,300,45,29,C.blue,true);txt(s,'属性相似的另一组',760,392,375,45,29,C.teal,true);
  txt(s,'距离',485,261,160,42,30,C.muted,true);line(s,330,330,760,300,C.muted,2,true);
  txt(s,'方向',375,465,160,40,28,C.gold,true);txt(s,'组成改变后，坐标怎样移动？',140,528,800,35,25,C.muted);txt(s,'概念示意，非实测坐标',905,530,305,28,18,C.muted,false,'right');return;
 }
 if(kind==='analogy'){
  const words=v.mode==='words',left=words?'男人':'辉长岩',right=words?'女人':'玄武岩',bottom=words?'国王':'花岗岩',top=words?'女王':'流纹岩';
  const pp=[[215,415,left],[470,265,right],[725,415,bottom],[980,265,top]];
  for(let i=0;i<pp.length;i++){const[x,y,t]=pp[i];dot(s,x,y,i<2?C.blue:C.teal,11);txt(s,t,x-83,y+20,166,48,30,i<2?C.blue:C.teal,true,'center');}
  arrow(s,235,399,450,279,C.blue,!words);arrow(s,745,399,960,279,C.teal,!words);
  txt(s,words?'关系向量的示意':'火山岩—深成岩对应关系',450,181,650,45,25,C.muted);
  formula(s,words?'女王 − 国王 ≈ 女人 − 男人':'玄武岩 − 辉长岩 ≈ 流纹岩 − 花岗岩？',100,510,1080);
  if(!words)txt(s,'待检验假设',920,457,265,35,25,C.red,true);return;
 }
 if(kind==='capabilities'){
  const labels=['预测有效性','局部邻域','全局结构','信息保真','指标连续性','泛化稳定性'];
  const center=node(s,'表示的能力',494,329,278,84,C.blue,C.pale,30);
  const pos=[[100,210],[500,201],[920,210],[100,465],[500,465],[920,465]];
  labels.forEach((t,i)=>{const[x,y]=pos[i],a=node(s,t,x,y,245,62,i<3?C.blue:C.gray);connect(s,center,a, i<3?'top':'bottom',i<3?'bottom':'top',C.line,'straight');});
  txt(s,'早期已量化',80,285,300,32,20,C.blue);txt(s,'后来继续补充',905,405,300,32,20,C.gray,false,'right');return;
 }
 if(kind==='timeline'){
  const ys=[236,300,364,428,492];v.items.forEach((it,i)=>{dot(s,120,ys[i]+17,C.blue,8);if(i<4)line(s,120,ys[i]+25,120,ys[i+1]+9,C.line,3);txt(s,it[0],170,ys[i]-4,280,44,28,C.blue,true);txt(s,it[1],490,ys[i]-4,675,44,26,C.ink);});return;
 }
 if(kind==='dataset'){
  rock(s,105,290,2.5,C.blue);txt(s,'全岩化学',75,488,305,44,31,C.blue,true,'center');
  facts(s,{items:[['样品规模','270,241','不同来源、不同测项覆盖'],['数值字段','34','主量、微量和辅助字段']]},425,215,750,345);return;
 }
 if(kind==='tokens'){
  const labs=[['SiO₂\n50 wt%','MgO\n8 wt%','Rb\n40 ppm','Sr\n300 ppm'],['SiO₂\n70 wt%','MgO\n1 wt%','Ni\n8 ppm']];
  labs.forEach((arr,r)=>{txt(s,'样品 '+(r?'B':'A'),75,235+r*171,170,50,29,C.blue,true);arr.forEach((a,i)=>node(s,a,270+i*213,215+r*171,180,97,r?C.teal:C.blue,C.pale,26));});
  txt(s,'教学示例；没有测量的元素，不生成有效单元',270,540,910,33,22,C.muted);return;
 }
 if(kind==='token'){
  const a=node(s,'元素身份：Rb',84,216,274,60),b=node(s,'标准化含量',84,337,274,60,C.teal),c=node(s,'两个遮盖标志',84,458,274,60,C.gold);
  const merge=node(s,'拼接为\n512 维输入',488,327,222,97);[a,b,c].forEach(n=>connect(s,n,merge));
  nn(s,804,302,175,130);txt(s,'共享小型神经网络',746,454,290,40,24,C.blue,true,'center');connect(s,merge,shape(s,770,362,1,1));
  const out=node(s,'768 维\n信息单元',1062,322,150,95,C.violet);connect(s,shape(s,1004,362,1,1),out);return;
 }
 if(kind==='v2architecture'){
  const a=node(s,'元素身份',67,218,168,54),b=node(s,'数值',67,310,168,54,C.teal),c=node(s,'遮盖标志',67,402,168,54,C.gold);
  const proj=node(s,'输入融合\n小型神经网络',309,294,196,108);nn(s,334,211,144,60);[a,b,c].forEach(n=>connect(s,n,proj));
  const trans=node(s,'12 层 Transformer\n元素间交换信息',584,285,291,126);connect(s,proj,trans);
  const outputs=[node(s,'数值恢复',981,202,215,53,C.teal),node(s,'字段识别',981,291,215,53,C.blue),node(s,'岩石标签预测',981,380,215,53,C.violet)];outputs.forEach(o=>connect(s,trans,o));
  txt(s,'训练时按遮盖任务选择',938,452,290,30,18,C.muted);
  const mean=node(s,'评价：移除标签输入，取有效数值单元均值',359,500,562,60,C.red,'#FFF7F6',23);connect(s,trans,mean,'bottom','top',C.red);return;
 }
 if(kind==='attention'){
  const target=node(s,'更新 Rb 的表示',492,354,296,92,C.blue,C.pale,28);
  const sources=[['Sr',116,223],['SiO₂',473,200],['MgO',894,223],['Ni',955,440]];
  sources.forEach(([label,x,y],i)=>{const a=node(s,label,x,y,180,65,i%2?C.teal:C.blue);connect(s,a,target,i===3?'left':'bottom',i===3?'right':'top',i%2?C.teal:C.blue,'straight');});
  txt(s,'根据当前样品，调整参考权重',365,486,540,45,26,C.blue,true,'center');txt(s,'注意力是信息汇总机制；权重本身不是因果证据',170,545,970,30,22,C.muted,false,'center');return;
 }
 if(kind==='masktrain'){
  const input=node(s,'一份样品',75,323,190,83);const tasks=[['45%','Rb = ？','恢复数值'],['15%','？ = 72.3','识别字段'],['40%','岩石类型 = ？','预测标签']];
  tasks.forEach((it,i)=>{const y=201+i*123;const t=node(s,it[1],417,y,325,74,[C.teal,C.blue,C.violet][i]);connect(s,input,t);txt(s,it[0],304,y-24,95,32,22,C.muted,true);const o=node(s,it[2],928,y,254,74,[C.teal,C.blue,C.violet][i]);connect(s,t,o);});return;
 }
 if(kind==='traininfer'){
  txt(s,'训练',88,196,300,48,30,C.blue,true);txt(s,'本轮评价',704,196,400,48,30,C.teal,true);line(s,626,199,626,547,C.line,2);
  node(s,'化学观测 ＋ 岩石标签',85,276,455,74);node(s,'遮盖任务与参数学习',85,429,455,74);arrow(s,313,360,313,409);
  node(s,'只输入化学观测',711,276,463,74,C.teal);node(s,'有效数值单元均值',711,429,463,74,C.teal);arrow(s,942,360,942,409,C.teal);return;
 }
 if(kind==='exploremap'){
  const rows=[['元素身份与数值','A / B','周期性质、比值、数值轨迹'],['样品背景与外部信息','C / D / X','背景读出、同位素、来源'],['过程与局部扰动','E / F','混合、元素响应、可加性'],['岩石标签与样品对齐','G / H','关系类比、标签检索'],['矿物代理与额外信息','I / J','矿物代理、传统指标增量'],['基线与鲁棒性','K','随机模型、缺测、输入顺序']];
  rows.forEach((r,i)=>{const y=190+i*61;txt(s,r[1],76,y,145,40,22,C.muted,true);txt(s,r[0],225,y,410,40,24,C.blue,true);txt(s,r[2],680,y,510,40,21,C.ink);if(i<5)line(s,76,y+48,1199,y+48,C.line,1);});return;
 }
 if(kind==='perturb'){
  ['基性背景','中性背景','酸性背景'].forEach((t,i)=>{const x=115+i*397;rock(s,x+72,215,1.2,[C.blue,C.teal,C.violet][i]);txt(s,t,x,322,280,45,27,C.ink,true,'center');node(s,'同一元素 ＋ 0.5 z',x,392,287,60,[C.blue,C.teal,C.violet][i]);arrow(s,x+110,515,x+237,477,[C.blue,C.teal,C.violet][i]);});
  txt(s,'比较三组响应方向，而不是比较三个绝对坐标',230,538,850,35,23,C.muted,false,'center');return;
 }
 if(kind==='addition'){
  arrow(s,170,470,357,286,C.blue);arrow(s,357,286,550,366,C.teal);arrow(s,170,470,550,366,C.gold,true);arrow(s,170,470,549,326,C.violet);
  txt(s,'单元素变化 A',78,238,300,37,23,C.blue,true);txt(s,'变化 B',399,259,210,38,23,C.teal,true);txt(s,'联合变化',373,405,230,36,23,C.violet,true);
  facts(s,{items:[['方向余弦','0.942','方向较接近'],['残差比例','0.374','并非严格相加']]},674,220,540,345);return;
 }
 if(kind==='inputcompare'){
  txt(s,'V2',75,220,200,50,31,C.blue,true);const a=node(s,'身份 ＋ 数值',250,216,295,79),b=node(s,'输入小网络',632,216,226,79),c=node(s,'注意力',950,216,229,79);connect(s,a,b);connect(s,b,c);
  txt(s,'RoPE',75,414,210,50,31,C.violet,true);const d=node(s,'元素身份',250,411,295,79,C.violet),e=node(s,'注意力 Q / K / V',692,414,487,79,C.violet);connect(s,d,e);const n=node(s,'数值控制旋转',659,310,310,57,C.teal);connect(s,n,e,'bottom','top',C.teal);return;
 }
 if(kind==='ropeblock'){
  const input=node(s,'元素表示',65,300,165,70);const split=shape(s,280,334,1,1);connect(s,input,split);
  const q=node(s,'Q',339,199,94,59),k=node(s,'K',339,302,94,59),val=node(s,'V',339,429,94,59,C.gray);[q,k,val].forEach(a=>connect(s,split,a));
  const qr=node(s,'旋转 Q',511,199,136,59,C.teal),kr=node(s,'旋转 K',511,302,136,59,C.teal);connect(s,q,qr);connect(s,k,kr);
  const value=node(s,'数值坐标',468,510,222,55,C.teal);
