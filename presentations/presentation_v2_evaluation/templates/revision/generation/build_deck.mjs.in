const selected=process.env.ONLY_PAGES?new Set(process.env.ONLY_PAGES.split(',').map(Number)):null;
for(const spec of slides){
 if(selected&&!selected.has(spec.page))continue;
 pageNo=spec.page;const s=pres.slides.add();
 if(spec.visual.kind==='cover'){
  s.background.fill=C.white;shape(s,0,0,25,720,C.blue);txt(s,'Element2Vec V2',73,69,900,67,31,C.blue,true);
  txt(s,'地球化学表示',73,206,1150,91,68,C.blue,true);txt(s,'设计、实验与认识',76,319,1140,85,52,C.ink,true);
  line(s,78,459,1190,459,C.line,2);txt(s,'V2 与 RoPE 分支的项目进展',79,494,1110,60,29,C.muted);txt(s,'2026.09.17',80,628,560,42,22,C.muted);
 }else if(spec.visual.kind==='agenda'){
  s.background.fill=C.white;txt(s,'汇报目录',72,54,1130,80,46,C.blue,true);
  chapters.forEach((t,i)=>{const active=i===spec.ch-1,y=175+i*69;txt(s,String(i+1).padStart(2,'0'),80,y,85,49,29,active?C.red:'#A3ACB6',active);txt(s,t,196,y,1000,50,30,active?C.red:'#8995A2',active);if(active)shape(s,61,y+12,7,28,C.red);});
  txt(s,`${String(spec.page).padStart(2,'0')} / ${slides.length}`,1112,684,103,20,14,C.muted,false,'right');
 }else{
  base(s,spec);const v=spec.visual;
  if(v.kind==='table')table(s,v);
  else if(v.kind==='chart')chart(s,v);
  else if(v.kind==='dualchart'){
   for(const [v2,x] of [[v.left,65],[v.right,675]])if(v2.kind==='facts')facts(s,v2,x,222,525,303);else chart(s,{...v2,compact:true},x,187,540,389);
  }else if(v.kind==='triplechart')v.panels.forEach((p,i)=>chart(s,{...p,compact:true},57+i*407,193,391,380));
  else if(v.kind==='facts')facts(s,v);
  else if(v.kind==='video'){
   await image(s,v.path,510,174,690,410);txt(s,'上方：真实化学变化\n下方：六种表示中的轨迹',78,217,399,101,27,C.blue,true);txt(s,'ZVector：原值标准化\nGeoNorm：地化标准化\nPCAGeo：地化降维\nRoPEz：RoPE-z\nRoPEgeo：RoPE-地化',78,348,406,181,22,C.muted);txt(s,'点击图像播放 40 秒动画',80,543,410,34,21,C.blue,true);
  }else diagram(s,v);
 }
 s.speakerNotes.textFrame.setText(spec.notes);
}
await fs.mkdir(OUT,{recursive:true});
const candidate=path.join(DIR,selected?'sample.pptx':'candidate.pptx');
await(await PresentationFile.exportPptx(pres)).save(candidate);
await fs.writeFile(path.join(DIR,'bounds.json'),JSON.stringify(bounds,null,2));
if(!selected){
 await fs.writeFile(path.join(DIR,'slides.json'),JSON.stringify(slides,null,2));
 const script='# 地球化学表示：设计、实验与认识\n\n主讲约 60 分钟（不含问答）。细节页可按备注短讲，追问段不计入主讲。\n\n'+slides.map(s=>`## 第 ${s.page} 页 · ${s.title}\n\n${s.ch?'板块：'+chapters[s.ch-1]+'；':''}建议 ${s.seconds} 秒${s.detail?'；细节页可快速带过':''}。\n\n${s.speech}\n\n${s.extra?'追问时展开：'+s.extra+'\n\n':''}证据索引：${s.evidence.join('；')}\n`).join('\n');
 await fs.writeFile(path.join(OUT,'中文演讲稿.md'),script);
 const quote=s=>'"'+String(s).replaceAll('"','""')+'"';
 const rows=[['页码','板块','标题','版式','建议秒数','讲述层级','证据索引'],...slides.map(s=>[s.page,s.ch?chapters[s.ch-1]:'封面',s.title,s.visual.kind,s.seconds,s.detail?'细节':'主讲',s.evidence.join('；')])];
 await fs.writeFile(path.join(OUT,'逐页证据索引.csv'),'\ufeff'+rows.map(r=>r.map(quote).join(',')).join('\n'));
 await fs.copyFile(path.join(DIR,'data.json'),path.join(OUT,'图表汇总数据.json'));
 await fs.copyFile(path.join(DIR,'source_manifest.json'),path.join(OUT,'来源数据清单.json'));
}
console.log('Saved',candidate,pres.slides.items.length,'slides');
if(process.env.RENDER==='1'){
 const dir=path.join(DIR,selected?'sample_rendered':'rendered');await fs.mkdir(dir,{recursive:true});
 const specs=slides.filter(s=>!selected||selected.has(s.page));
 for(let i=0;i<pres.slides.items.length;i++){
  const b=await pres.export({slide:pres.slides.items[i],format:'png',scale:1.5});await fs.writeFile(path.join(dir,`slide-${String(specs[i].page).padStart(2,'0')}.png`),new Uint8Array(await b.arrayBuffer()));
  if(i%5===0)console.log('Rendered',i+1,'/',pres.slides.items.length);
 }
}
